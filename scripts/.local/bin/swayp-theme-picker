#!/bin/sh
set -eu

# Visual SwayP theme selector. The actual UI is a Quickshell panel.
if command -v qs >/dev/null 2>&1; then
    exec qs ipc call shell toggle swayp.theme-selector "{}"
fi

# Fallback for sessions where Quickshell IPC is unavailable.
exec fuzzel --dmenu --prompt "Theme: " <<EOF
Visual theme selector unavailable
EOF
