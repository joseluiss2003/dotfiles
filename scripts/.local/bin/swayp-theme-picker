#!/bin/sh
set -eu

THEMES_DIR="${HOME}/.config/swayp/themes"
THEME_SET="${HOME}/.local/bin/swayp-theme-set"

[ -d "$THEMES_DIR" ] || exit 1
[ -f "$THEME_SET" ] || exit 1

choices=""
for dir in "$THEMES_DIR"/*; do
    [ -d "$dir" ] || continue
    name=""
    if [ -f "$dir/theme.toml" ]; then
        name=$(sed -n 's/^name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/theme.toml" | head -n1)
    fi
    [ -n "$name" ] || name=$(basename "$dir")
    choices=${choices:+$choices\n}$name
done

[ -n "$choices" ] || exit 1

selected=$(printf '%b\n' "$choices" | fuzzel --dmenu --prompt "Theme: " --width 28) || exit 0
[ -n "$selected" ] || exit 0

for dir in "$THEMES_DIR"/*; do
    [ -d "$dir" ] || continue
    name=""
    if [ -f "$dir/theme.toml" ]; then
        name=$(sed -n 's/^name[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/theme.toml" | head -n1)
    fi
    [ -n "$name" ] || name=$(basename "$dir")
    if [ "$name" = "$selected" ]; then
        exec "$THEME_SET" "$(basename "$dir")"
    fi
done

exit 1
