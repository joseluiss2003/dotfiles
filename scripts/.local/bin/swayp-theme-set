#!/bin/sh
set -eu

PERSISTENT_THEME_FILE="${HOME}/.config/swayp/current-theme"
DEFAULT_THEME="catppuccin"

THEME="${1:-}"

# Restore the persisted selection when no theme was explicitly requested.
# The runtime state is kept as a fallback for upgrades from older SwayP versions.
if [ -z "$THEME" ] && [ -f "$PERSISTENT_THEME_FILE" ]; then
    THEME="$(sed -n '1p' "$PERSISTENT_THEME_FILE")"
fi

if [ -z "$THEME" ] && [ -L "$HOME/.local/state/swayp/current/theme" ]; then
    THEME="$(basename "$(readlink "$HOME/.local/state/swayp/current/theme")")"
fi

[ -n "$THEME" ] || THEME="$DEFAULT_THEME"

BASE="${HOME}/.config/swayp/themes"
THEME_DIR="${BASE}/${THEME}"
STATE_DIR="${HOME}/.local/state/swayp/current"
PALETTE_OUTPUT="${STATE_DIR}/palette.json"
PALETTE_STAGED_OUTPUT="${STATE_DIR}/palette.json.next"

# Wallpaper transition is the only geometric reveal during a theme change.
# Keep Quickshell out of the wallpaper transition path to avoid overlapping
# center-out masks.
GENERATED_DIR="${HOME}/.config/swayp/generated"

[ -n "$THEME" ] || { printf '%s\n' "usage: swayp-theme-set <theme>" >&2; exit 2; }
[ -d "$THEME_DIR" ] || { printf 'Unknown SwayP theme: %s\n' "$THEME" >&2; exit 1; }
[ -f "$THEME_DIR/colors.toml" ] || { printf 'Theme has no colors.toml: %s\n' "$THEME" >&2; exit 1; }

mkdir -p "$STATE_DIR" "$GENERATED_DIR" "$(dirname "$PERSISTENT_THEME_FILE")"

python3 - "$THEME_DIR/colors.toml" "$PALETTE_STAGED_OUTPUT" "$GENERATED_DIR" "$THEME" <<'PY'
import json, os, sys, tomllib, colorsys, shutil, subprocess

colors_path, palette_path, generated_dir, theme = sys.argv[1:]
with open(colors_path, "rb") as f:
    c = tomllib.load(f)

required = [
    "background","foreground","muted","red","green","yellow",
    "blue","magenta","cyan","bright_foreground",
    "bright_red","bright_green","bright_yellow",
    "bright_blue","bright_magenta","bright_cyan"
]
missing = [k for k in required if k not in c]
if missing:
    raise SystemExit("missing theme colors: " + ", ".join(missing))

p = [c["background"], c["red"], c["green"], c["yellow"], c["blue"],
     c["magenta"], c["cyan"], c["foreground"], c["muted"],
     c["bright_red"], c["bright_green"], c["bright_yellow"],
     c["bright_blue"], c["bright_magenta"], c["bright_cyan"],
     c["bright_foreground"]]

bg, red, green, yellow, blue, magenta, cyan, fg, muted, br, bg_, by, bb, bm, bc, bfg = p
accent = c["accent"]

# Fastfetch logo palette: intentionally independent from the terminal/module palette.
# Keep one hue (the theme accent) and vary only luminance so the mark reads as
# one coherent colour family, like Omarchy's layered branding.
r, g, b = (int(accent[i:i+2], 16) / 255 for i in (1, 3, 5))
h, l, s = colorsys.rgb_to_hls(r, g, b)
logo_lightness = (0.18, 0.28, 0.40, 0.50, 0.62, 0.74)
logo_colors = []
for lightness in logo_lightness:
    logo_r, logo_g, logo_b = colorsys.hls_to_rgb(h, lightness, s)
    logo_colors.append("#{:02X}{:02X}{:02X}".format(round(logo_r * 255), round(logo_g * 255), round(logo_b * 255)))

semantic = {
    "accent": c["accent"],
    "selection": c["selection"],
    "muted": c["muted"],
    "background": c["background"],
    "dark_background": c["dark_background"],
    "darker_background": c["darker_background"],
    "lighter_background": c["lighter_background"],
    "foreground": c["foreground"],
    "dark_foreground": c["dark_foreground"],
    "light_foreground": c["light_foreground"],
    "bright_foreground": c["bright_foreground"],
    "logo": logo_colors,
}

with open(palette_path, "w") as f:
    json.dump({"colors": p, "semantic": semantic}, f, indent=2)
    f.write("\n")

surface = bg

def write(name, text):
    with open(os.path.join(generated_dir,name),"w") as f: f.write(text)

write("sway-colors.conf", f"""# Generated by SwayP theme: {theme}
set $color_bg {bg}
set $color_surface {surface}
set $color_fg {fg}
set $color_primary {accent}
set $color_primary_container {c["lighter_background"]}
set $color_secondary {c["lighter_background"]}
set $color_error {red}
set $color_outline {muted}

client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_inactive $color_outline $color_surface $color_fg $color_outline $color_outline
client.unfocused $color_outline $color_bg $color_fg $color_outline $color_outline
client.urgent $color_error $color_error $color_fg $color_error $color_error
""")
write("sway-runtime-colors.sh", f"""# Generated by SwayP theme: {theme}
color_bg="{bg}"
color_surface="{surface}"
color_fg="{fg}"
color_primary="{accent}"
color_primary_container="{c["lighter_background"]}"
color_error="{red}"
color_outline="{muted}"
""")
write("mako-colors", f"""# Generated by SwayP theme: {theme}
background-color={surface}f7
text-color={fg}
border-color={accent}
progress-color=over {accent}
""")
write("fuzzel-colors.ini", f"""# Generated by SwayP theme: {theme}
[colors]
background={surface}f7
text={fg}ff
match={accent}ff
selection={blue}ff
selection-text={fg}ff
selection-match={fg}ff
border={accent}ff

[border]
width=2
radius=0
""")
write("kitty-colors.conf", f"""# Generated by SwayP theme: {theme}
background {surface}
foreground {fg}
background_opacity 0.97

# Core UI
cursor {accent}
cursor_text_color {bg}
selection_background {blue}
selection_foreground {fg}
active_border_color {accent}
inactive_border_color {muted}
bell_border_color {red}

# Tabs
active_tab_foreground {bg}
active_tab_background {accent}
inactive_tab_foreground {muted}
inactive_tab_background {bg}
tab_bar_background {bg}

# ANSI palette
color0 {bg}
color1 {red}
color2 {green}
color3 {yellow}
color4 {blue}
color5 {magenta}
color6 {cyan}
color7 {fg}
color8 {muted}
color9 {br}
color10 {bg_}
color11 {by}
color12 {bb}
color13 {bm}
color14 {bc}
color15 {bfg}
""")
write("starship.toml", f'''# Generated by SwayP theme: {theme}
"$schema" = 'https://starship.rs/config-schema.json'
palette = "swayp"
format = """
$directory$git_branch$git_status$cmd_duration
$character
"""

[palettes.swayp]
foreground = "{fg}"
primary = "{accent}"
secondary = "{blue}"
tertiary = "{magenta}"
error = "{red}"
muted = "{muted}"

[directory]
style = "bold fg:secondary"
truncation_length = 3
truncate_to_repo = false
format = "[$path](fg:secondary) "

[git_branch]
symbol = "󰘬 "
style = "bold fg:tertiary"
format = "[$symbol$branch](fg:tertiary) "

[git_status]
style = "fg:primary"
format = "[$all_status$ahead_behind](fg:primary) "

[cmd_duration]
min_time = 2000
format = " took [$duration](fg:muted)"

[character]
success_symbol = "[❯](bold fg:primary)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:primary)"
''')

fastfetch_logo_template = os.path.join(os.environ["HOME"], ".config", "swayp", "branding", "swayp-fastfetch.svg")
fastfetch_svg = os.path.join(generated_dir, "swayp-fastfetch.svg")
fastfetch_logo = os.path.join(generated_dir, "swayp-fastfetch.png")
if os.path.isfile(fastfetch_logo_template):
    with open(fastfetch_logo_template, "r") as f:
        fastfetch_svg_content = f.read().replace("__SWAYP_COLOR__", accent)
    with open(fastfetch_svg, "w") as f:
        f.write(fastfetch_svg_content)

    # Rasterize explicitly with a transparent background. Some SVG delegates
    # otherwise default the canvas to white when Fastfetch/Kitty decodes it.
    magick = shutil.which("magick")
    if magick:
        subprocess.run(
            [magick, "-background", "none", fastfetch_svg, "-alpha", "on", fastfetch_logo],
            check=True,
        )

write("fastfetch.jsonc", f'''{{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {{
    "type": "kitty",
    "source": "{fastfetch_logo}",
    "width": 32,
    "height": 14,
    "color": {{
      "1": "{logo_colors[0]}",
      "2": "{logo_colors[1]}",
      "3": "{logo_colors[2]}",
      "4": "{logo_colors[3]}",
      "5": "{logo_colors[4]}",
      "6": "{logo_colors[5]}"
    }},
    "padding": {{ "top": 1, "right": 3, "left": 4 }}
  }},
  "display": {{
    "disableLinewrap": true,
    "color": {{ "keys": "{accent}", "output": "{fg}", "separator": "{muted}" }},
    "key": {{ "width": 14, "type": "string" }}
  }},
  "modules": [
    "break",
    {{ "type": "custom", "outputColor": "{muted}", "format": "┌──────────────────────Hardware────────────────────┐" }},
    {{ "type": "host", "key": " PC", "keyColor": "{accent}" }},
    {{ "type": "cpu", "key": " CPU", "keyColor": "{yellow}" }},
    {{ "type": "gpu", "key": " GPU", "keyColor": "{blue}" }},
    {{ "type": "memory", "key": " Memoria", "keyColor": "{green}" }},
    {{ "type": "disk", "key": " Disco", "keyColor": "{cyan}", "folders": ["/"] }},
    {{ "type": "custom", "outputColor": "{muted}", "format": "└──────────────────────────────────────────────────┘" }},
    "break",
    {{ "type": "custom", "outputColor": "{muted}", "format": "┌──────────────────────Software────────────────────┐" }},
    {{ "type": "os", "key": " OS", "keyColor": "{accent}" }},
    {{ "type": "kernel", "key": " Kernel", "keyColor": "{magenta}" }},
    {{ "type": "de", "key": " Entorno", "keyColor": "{blue}" }},
    {{ "type": "shell", "key": " Shell", "keyColor": "{green}" }},
    {{ "type": "terminal", "key": " Terminal", "keyColor": "{cyan}" }},
    {{ "type": "packages", "key": " Paquetes", "keyColor": "{yellow}" }},
    {{ "type": "custom", "outputColor": "{muted}", "format": "└──────────────────────────────────────────────────┘" }}
  ]
}}
''')
PY


ln -sfn "$THEME_DIR" "$STATE_DIR/theme"
printf '%s\n' "$THEME" > "$PERSISTENT_THEME_FILE"

# Remove state files from pre-static-theme versions.
rm -f "$STATE_DIR/theme.name" "$STATE_DIR/palette-source"

# Each theme owns a default wallpaper: use the first curated image in a stable
# lexical order. The dedicated wallpaper picker can still override it later.
THEME_WALLPAPER_DIR="$HOME/.config/swayp/wallpapers/$THEME"
DEFAULT_WALLPAPER=""
if [ -d "$THEME_WALLPAPER_DIR" ]; then
    DEFAULT_WALLPAPER="$(
        find "$THEME_WALLPAPER_DIR" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.svg' \) \
            -print 2>/dev/null | sort | head -n 1
    )"
fi

# Start the fast wallpaper fade and palette transition together.
# Do not wait for awww: its CLI may remain attached to the transition request,
# which would make the palette update visibly lag behind the wallpaper.
#
# Fork awww first, then swap the staged palette immediately. Both transitions
# therefore begin from the same shell turn; the wallpaper fade is intentionally
# matches the Quickshell palette transition duration exactly.
if [ -n "$DEFAULT_WALLPAPER" ] && command -v awww >/dev/null 2>&1; then
    awww img \
        --transition-type fade \
        --transition-fps 240 \
        --transition-duration 0.50 \
        "$DEFAULT_WALLPAPER" >/dev/null 2>&1 &

    ln -sfn "$DEFAULT_WALLPAPER" "$STATE_DIR/background"

    if [ -f "$PALETTE_STAGED_OUTPUT" ]; then
        mv -f "$PALETTE_STAGED_OUTPUT" "$PALETTE_OUTPUT"

        # Give awww a tiny head start so its compositor-side fade begins just
        # before Quickshell repaints the shell palette. 10 ms is the midpoint
        # between the previous leading/lagging timings.
        sleep 0.019

        # Push the exact new palette directly into the running Quickshell
        # instead of waiting for FileView's filesystem watcher. The watcher
        # is intentionally kept as a persistence/fallback path, but it must
        # not decide when the visual transition starts.
        if command -v qs >/dev/null 2>&1; then
            PALETTE_B64="$(base64 -w0 "$PALETTE_OUTPUT")"
            SHELL_B64="$(base64 -w0 "$THEME_DIR/theme.toml")"
            qs ipc call shell applyTheme "$PALETTE_B64" "$SHELL_B64" >/dev/null 2>&1 || true
        fi
    fi
fi

# Apply all runtime application colors at the beginning of the visual
# transition. Kitty and Sway must move with the wallpaper and Quickshell,
# not after the 500 ms reveal has already finished.

if command -v kitty >/dev/null 2>&1 && [ -f "$GENERATED_DIR/kitty-colors.conf" ]; then
    # Kitty creates one control socket per running instance. Discover the
    # sockets directly so every Kitty process gets the new palette.
    for KITTY_SOCKET_PATH in /tmp/swayp-kitty.sock-*; do
        [ -S "$KITTY_SOCKET_PATH" ] || continue
        kitty @ --to "unix:$KITTY_SOCKET_PATH" set-colors --all "$GENERATED_DIR/kitty-colors.conf" >/dev/null 2>&1 || true
    done
fi

if command -v swaymsg >/dev/null 2>&1; then
    SWAY_RUNTIME_COLORS="$GENERATED_DIR/sway-runtime-colors.sh"
    if [ -f "$SWAY_RUNTIME_COLORS" ]; then
        # shellcheck disable=SC1090
        . "$SWAY_RUNTIME_COLORS"
        swaymsg "client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary" >/dev/null 2>&1 || true
        swaymsg "client.focused_inactive $color_outline $color_surface $color_fg $color_outline $color_outline" >/dev/null 2>&1 || true
        swaymsg "client.unfocused $color_outline $color_bg $color_fg $color_outline $color_outline" >/dev/null 2>&1 || true
        swaymsg "client.urgent $color_error $color_error $color_fg $color_error $color_error" >/dev/null 2>&1 || true
    fi
fi

if command -v makoctl >/dev/null 2>&1 && pgrep -x mako >/dev/null 2>&1; then
    makoctl reload >/dev/null 2>&1 || true
fi

printf 'SwayP theme applied: %s\n' "$THEME"
