#!/bin/sh
set -eu

# SwayP wallpaper picker
# Opens the shared Quickshell image selector using the active theme's pool.
# The picker only chooses a file; this script owns applying and persisting it.

THEME_FILE="$HOME/.config/swayp/current-theme"
THEME_NAME=""
if [ -f "$THEME_FILE" ]; then
    THEME_NAME="$(sed -n '1p' "$THEME_FILE")"
elif [ -L "$HOME/.local/state/swayp/current/theme" ]; then
    THEME_NAME="$(basename "$(readlink "$HOME/.local/state/swayp/current/theme")")"
fi

THEME_WALLPAPER_DIR="$HOME/.config/swayp/wallpapers/$THEME_NAME"
GLOBAL_WALLPAPER_DIR="$HOME/Pictures/wallpapers"

if [ -n "$THEME_NAME" ] && [ -d "$THEME_WALLPAPER_DIR" ] && \
   find "$THEME_WALLPAPER_DIR" -maxdepth 1 -type f -print -quit 2>/dev/null | grep -q .; then
    WALLPAPER_DIR="$THEME_WALLPAPER_DIR"
else
    WALLPAPER_DIR="$GLOBAL_WALLPAPER_DIR"
fi

[ -d "$WALLPAPER_DIR" ] || {
    notify-send "Wallpapers" "No existe $WALLPAPER_DIR"
    exit 1
}

STATE_DIR="$HOME/.local/state/wallpaper"
SWAYP_STATE_DIR="$HOME/.local/state/swayp/current"
CURRENT="$STATE_DIR/current"
mkdir -p "$STATE_DIR" "$SWAYP_STATE_DIR"

# One picker at a time.
LOCK_FILE="$STATE_DIR/picker.lock"
exec 9>"$LOCK_FILE"
if command -v flock >/dev/null 2>&1; then
    flock -n 9 || exit 0
fi

TMP_DIR="$(mktemp -d "$STATE_DIR/picker.XXXXXX")"
SELECTION_FILE="$TMP_DIR/selection"
DONE_FILE="$TMP_DIR/done"
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM

ROWS="$TMP_DIR/rows"
"$HOME/.config/quickshell/plugins/image-picker/list.sh" "$WALLPAPER_DIR" >"$ROWS"

[ -s "$ROWS" ] || {
    notify-send "Wallpapers" "No hay wallpapers en $WALLPAPER_DIR"
    exit 1
}

ROWS_B64="$(base64 -w0 "$ROWS")"

CURRENT_WALLPAPER=""
if [ -f "$CURRENT" ]; then
    CURRENT_WALLPAPER="$(sed -n '1p' "$CURRENT")"
fi

# Quickshell owns the visual selector. This script waits for its explicit
# completion marker, then applies the selected file with awww.
qs ipc call image-selector open \
    "$WALLPAPER_DIR" \
    "$ROWS_B64" \
    "$CURRENT_WALLPAPER" \
    "$SELECTION_FILE" \
    "$DONE_FILE" \
    "true" \
    "true" >/dev/null

while [ ! -f "$DONE_FILE" ]; do
    sleep 0.05
done

[ -f "$SELECTION_FILE" ] || exit 0
SELECTED_FILE="$(sed -n '1p' "$SELECTION_FILE")"

[ -n "$SELECTED_FILE" ] || exit 0
[ -f "$SELECTED_FILE" ] || exit 1

if ! awww img \
    --transition-type fade \
    --transition-fps 120 \
    --transition-duration 0.24 \
        "$SELECTED_FILE"; then
    notify-send "Wallpaper" "No se pudo aplicar $(basename "$SELECTED_FILE")"
    exit 1
fi

printf '%s\n' "$SELECTED_FILE" >"$CURRENT"
ln -sfn "$SELECTED_FILE" "$SWAYP_STATE_DIR/background"

notify-send "Wallpaper" "$(basename "$SELECTED_FILE")"
