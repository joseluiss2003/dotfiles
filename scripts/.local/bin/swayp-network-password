#!/usr/bin/env bash
set -euo pipefail

iface="${1:-}"
[ -n "$iface" ] || exit 1

connection="$(nmcli -g GENERAL.CONNECTION device show "$iface" 2>/dev/null || true)"
[ -n "$connection" ] && [ "$connection" != "--" ] || exit 1

password="$(nmcli -s -g 802-11-wireless-security.psk connection show "$connection" 2>/dev/null || true)"
printf '%s\n' "$password"
