#!/bin/sh

set -eu

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<'EOF'
Change wallpaper
Change theme
Lock screen
Screenshot
Terminal
Files
EOF

find     "$HOME/.local/share/applications"     /usr/share/applications     -type f -name '*.desktop' 2>/dev/null |
while IFS= read -r file; do
    name="$(awk -F= '
        /^Name=/ {
            print substr($0, 6)
            exit
        }
    ' "$file")"

    [ -n "$name" ] && printf '%s\n' "$name"
done |
sort -fu >> "$tmp"

choice="$(fuzzel --dmenu --prompt 'SwayP > ' < "$tmp")"
[ -n "$choice" ] || exit 0

case "$choice" in
    "Change wallpaper")
        exec env PATH="$HOME/.local/bin:$PATH" wallpaper-picker
        ;;
    "Change theme")
        exec env PATH="$HOME/.local/bin:$PATH" swayp-theme-picker
        ;;
    "Lock screen")
        exec qs ipc call lock lock
        ;;
    "Screenshot")
        exec env PATH="$HOME/.local/bin:$PATH" swayp-screenshot-edit
        ;;
    "Terminal")
        exec kitty
        ;;
    "Files")
        exec nautilus
        ;;
esac

find     "$HOME/.local/share/applications"     /usr/share/applications     -type f -name '*.desktop' 2>/dev/null |
while IFS= read -r file; do
    name="$(awk -F= '
        /^Name=/ {
            print substr($0, 6)
            exit
        }
    ' "$file")"

    if [ "$name" = "$choice" ]; then
        id="$(basename "$file" .desktop)"
        exec gtk4-launch "$id"
    fi
done

exit 0
