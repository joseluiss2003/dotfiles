#!/bin/sh
set -eu

WALLPAPER="${1:-}"
STATE_DIR="${HOME}/.local/state/swayp/current"
GENERATED_DIR="${HOME}/.config/swayp/generated"
FASTFETCH_DIR="${HOME}/.config/fastfetch"
OUTPUT="${STATE_DIR}/aether-palette.json"
STATE_OUTPUT="${STATE_DIR}/aether-state.json"
TMP="${OUTPUT}.tmp"
STATE_TMP="${STATE_OUTPUT}.tmp"
MODE="${SWAYP_AETHER_MODE:-material}"

[ -n "$WALLPAPER" ] || {
    printf '%s\n' "usage: swayp-aether-theme <wallpaper>" >&2
    exit 2
}

[ -f "$WALLPAPER" ] || {
    printf '%s\n' "Wallpaper not found: $WALLPAPER" >&2
    exit 1
}

command -v aether >/dev/null 2>&1 || {
    printf '%s\n' "aether is required but was not found on PATH" >&2
    exit 127
}

command -v jq >/dev/null 2>&1 || {
    printf '%s\n' "jq is required but was not found on PATH" >&2
    exit 127
}

mkdir -p "$STATE_DIR" "$GENERATED_DIR" "$FASTFETCH_DIR"

# Aether is the single palette authority. When its editor is available,
# preserve the editor state; otherwise extract a fresh palette headlessly.
if aether status --json > "$STATE_TMP" 2>/dev/null; then
    aether extract "$WALLPAPER" >/dev/null
    aether status --json > "$STATE_TMP"
else
    aether --extract-palette "$WALLPAPER" \
        --extract-mode "$MODE" \
        --json > "$STATE_TMP"
fi

# Normalize Aether's JSON shapes into the canonical SwayP object.
jq -e '
    if type == "array" then
        {colors: .}
    elif (.palette | type) == "array" then
        {colors: .palette}
    elif (.colors | type) == "array" then
        {colors: .colors}
    else
        error("Aether JSON does not contain a palette array")
    end
' "$STATE_TMP" > "$TMP"

jq -e '
    (.colors | type == "array") and
    (.colors | length == 16) and
    all(.colors[]; type == "string" and test("^#[0-9A-Fa-f]{6}$"))
' "$TMP" >/dev/null

mv -f "$TMP" "$OUTPUT"
mv -f "$STATE_TMP" "$STATE_OUTPUT"

# Read the canonical ANSI palette once. Everything below is derived from it.
set -- \
    $(jq -r '.colors[]' "$OUTPUT")

bg="$1"
red="$2"
green="$3"
yellow="$4"
blue="$5"
magenta="$6"
cyan="$7"
fg="$8"
muted="$9"
bright_red="${10}"
bright_green="${11}"
bright_yellow="${12}"
bright_blue="${13}"
bright_magenta="${14}"
bright_cyan="${15}"
bright_fg="${16}"

# Match Quickshell's Aether-tinted background:
# backgroundDeep = mix(background, mix(green, cyan, 0.50), 0.10)
aether_bg_tinted="$(awk -v bg="$bg" -v green="$green" -v cyan="$cyan" '
function hexpair(s, p) { return strtonum("0x" substr(s, p, 2)) }
BEGIN {
    for (i = 1; i <= 6; i++) {
        b = hexpair(substr(bg, 2), i * 2 - 1)
        g = (hexpair(substr(green, 2), i * 2 - 1) + hexpair(substr(cyan, 2), i * 2 - 1)) / 2
        v = int(b * 0.90 + g * 0.10 + 0.5)
        printf "%02x", v
    }
}' )"
aether_bg_tinted="#$aether_bg_tinted"

cat > "${GENERATED_DIR}/colors.toml" <<EOF
# Generated by SwayP from Aether. Do not edit.
mode = "dark"
accent = "$cyan"
selection = "$blue"
muted = "$muted"

background = "$bg"
dark_background = "$bg"
darker_background = "$bg"
lighter_background = "$muted"

foreground = "$fg"
dark_foreground = "$muted"
light_foreground = "$fg"
bright_foreground = "$bright_fg"

red = "$red"
green = "$green"
yellow = "$yellow"
blue = "$blue"
magenta = "$magenta"
cyan = "$cyan"

color0 = "$bg"
color1 = "$red"
color2 = "$green"
color3 = "$yellow"
color4 = "$blue"
color5 = "$magenta"
color6 = "$cyan"
color7 = "$fg"
color8 = "$muted"
color9 = "$bright_red"
color10 = "$bright_green"
color11 = "$bright_yellow"
color12 = "$bright_blue"
color13 = "$bright_magenta"
color14 = "$bright_cyan"
color15 = "$bright_fg"
EOF

cat > "${GENERATED_DIR}/sway-colors.conf" <<EOF
# Generated by SwayP from Aether. Do not edit.
set \$color_bg $bg
set \$color_surface $bg
set \$color_fg $fg
set \$color_primary $cyan
set \$color_primary_container $blue
set \$color_secondary $blue
set \$color_error $red
set \$color_outline $muted

client.focused \$color_primary \$color_primary_container \$color_fg \$color_primary \$color_primary
client.focused_inactive \$color_outline \$color_surface \$color_fg \$color_outline \$color_outline
client.unfocused \$color_outline \$color_bg \$color_fg \$color_outline \$color_outline
client.urgent \$color_error \$color_error \$color_fg \$color_error \$color_error
EOF

cat > "${GENERATED_DIR}/mako-colors" <<EOF
# Generated by SwayP from Aether. Do not edit.
background-color=${bg}f7
text-color=$fg
border-color=$cyan
progress-color=over $cyan
EOF

cat > "${GENERATED_DIR}/fuzzel-colors.ini" <<EOF
# Generated by SwayP from Aether. Do not edit.
[colors]
background=${bg}f7
text=${fg}ff
match=${cyan}ff
selection=${blue}ff
selection-text=${fg}ff
selection-match=${fg}ff
border=${cyan}ff

[border]
width=2
radius=0
EOF

cat > "${GENERATED_DIR}/kitty-colors.conf" <<EOF
# Generated by SwayP from Aether. Do not edit.
background $aether_bg_tinted
foreground $fg
# Match the SwayP bar tone exactly; the bar itself handles the subtle alpha.
background_opacity 1.0

cursor $cyan
cursor_text_color $bg

selection_background $blue
selection_foreground $fg

color0 $bg
color1 $red
color2 $green
color3 $yellow
color4 $blue
color5 $magenta
color6 $cyan
color7 $fg
color8 $muted
color9 $bright_red
color10 $bright_green
color11 $bright_yellow
color12 $bright_blue
color13 $bright_magenta
color14 $bright_cyan
color15 $bright_fg
EOF

cat > "$HOME/.config/fastfetch/config.jsonc" <<EOF
{
  "\$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "color": {
      "1": "$cyan",
      "2": "$blue",
      "3": "$magenta",
      "4": "$bright_blue",
      "5": "$bright_cyan",
      "6": "$bright_magenta"
    },
    "padding": { "top": 1, "right": 6, "left": 1 }
  },
  "display": {
    "disableLinewrap": true,
    "color": { "keys": "$cyan", "output": "$fg", "separator": "$muted" },
    "key": { "width": 14, "type": "string" }
  },
  "modules": [
    "break",
    { "type": "custom", "outputColor": "$muted", "format": "┌──────────────────────Hardware────────────────────┐" },
    { "type": "host", "key": " PC" },
    { "type": "cpu", "key": " CPU" },
    { "type": "gpu", "key": " GPU" },
    { "type": "memory", "key": " Memoria" },
    { "type": "disk", "key": " Disco", "folders": ["/"] },
    { "type": "custom", "outputColor": "$muted", "format": "└──────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "outputColor": "$muted", "format": "┌──────────────────────Software────────────────────┐" },
    { "type": "os", "key": " OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "de", "key": " Entorno" },
    { "type": "shell", "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "packages", "key": " Paquetes" },
    { "type": "custom", "outputColor": "$muted", "format": "└──────────────────────────────────────────────────┘" }
  ]
}
EOF

cat > "${GENERATED_DIR}/starship.toml" <<EOF
# Generated by SwayP from Aether. Do not edit.
"\$schema" = 'https://starship.rs/config-schema.json'

palette = "swayp"

format = """
\$directory\
\$git_branch\
\$git_status
\$character
"""

[palettes.swayp]
foreground = "$fg"
primary = "$cyan"
secondary = "$blue"
tertiary = "$magenta"
error = "$red"
muted = "$muted"

[directory]
style = "bold fg:secondary"
truncation_length = 3
truncate_to_repo = false
format = "[\$path](fg:secondary) "

[git_branch]
symbol = "󰘬 "
style = "bold fg:tertiary"
format = "[\$symbol\$branch](fg:tertiary) "

[git_status]
style = "fg:primary"
format = "[\$all_status\$ahead_behind](fg:primary) "

[character]
success_symbol = "[❯](bold fg:primary)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:primary)"

[cmd_duration]
min_time = 2000
format = " took [\$duration](fg:muted)"
EOF


# Refresh long-running consumers when they expose a reload signal.
if command -v makoctl >/dev/null 2>&1 && pgrep -x mako >/dev/null 2>&1; then
    makoctl reload >/dev/null 2>&1 || true
fi

if command -v kitty >/dev/null 2>&1 && pgrep -x kitty >/dev/null 2>&1; then
    pkill -USR1 -x kitty >/dev/null 2>&1 || true
fi
