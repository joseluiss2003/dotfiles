#!/bin/sh

options="󰌾  Bloquear
󰒲  Suspender
󰍃  Cerrar sesión
󰜉  Reiniciar
󰐥  Apagar"

choice=$(printf '%s\n' "$options" | fuzzel \
    --dmenu \
    --hide-prompt \
    --minimal-lines \
    --lines 5 \
    --width 18 \
    --anchor top-right \
    --x-margin 2 \
    --y-margin 2 \
    --horizontal-pad 10 \
    --vertical-pad 4)

case "$choice" in
    "󰌾  Bloquear")
        swaylock -f
        ;;
    "󰒲  Suspender")
        systemctl suspend
        ;;
    "󰍃  Cerrar sesión")
        swaymsg exit
        ;;
    "󰜉  Reiniciar")
        systemctl reboot
        ;;
    "󰐥  Apagar")
        systemctl poweroff
        ;;
esac
