{
    "layer": "top",
    "position": "top",

    "height": 34,
    "spacing": 4,

    "modules-left": [
        "sway/workspaces",
        "custom/media"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "custom/power"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "clock": {
        "format": "󰥔  {:%H:%M}",
        "interval": 1,
        "tooltip-format": "<big>{:%A}</big>\n{:%d %B %Y}"
    },

    "network": {
        "interval": 3,
        "format-ethernet": "󰈀",
        "format-wifi": "󰤨",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}\n{ipaddr}"
    },


"pulseaudio": {
    "scroll-step": 2,
    "format": "{icon}",
    "format-muted": "󰖁",
    "tooltip": true,
    "tooltip-format": "{volume}% · {desc}",
    "format-icons": {
        "default": [
            "󰕿",
            "󰖀",
            "󰕾"
        ]
    },
    "on-click": "~/.local/bin/audio-popup",
    "on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-"
    },

    "cpu": {
        "interval": 2,
        "format": "󰻠",
        "tooltip-format": "CPU: {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛",
        "tooltip-format": "RAM: {percentage}%"
    },

"custom/power": {
    "format": "⏻",
    "tooltip": "Menú de energía",
    "on-click": "~/.local/bin/power-menu"
},


"custom/media": {
    "return-type": "json",
    "exec": "~/.local/bin/media-bar",
    "format": "{icon}  {text}",
    "format-icons": {
        "Playing": "󰐊",
        "Paused": "󰏤",
        "Stopped": "󰓛"
    },
    "tooltip": true,
    "max-length": 35,
    "on-click": "~/.local/bin/media-popup",
    "on-click-middle": "playerctl --player=playerctld play-pause",
    "on-click-right": "playerctl --player=playerctld next"
},    

    "tray": {
        "icon-size": 15,
        "spacing": 4
    }
}
