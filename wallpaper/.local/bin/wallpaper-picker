#!/bin/sh

WALLPAPER_DIR="$HOME/Pictures/wallpapers"
STATE_DIR="$HOME/.local/state/wallpaper"
CURRENT="$STATE_DIR/current"

mkdir -p "$STATE_DIR"

files=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) |
    sort)

[ -n "$files" ] || {
    notify-send "Wallpapers" "No hay wallpapers en $WALLPAPER_DIR"
    exit 1
}

selected_name=$(
    printf '%s\n' "$files" |
    while IFS= read -r file; do
        basename "$file"
    done |
    fuzzel --dmenu --prompt "Wallpaper  "
)

[ -n "$selected_name" ] || exit 0

selected_file=$(
    printf '%s\n' "$files" |
    while IFS= read -r file; do
        if [ "$(basename "$file")" = "$selected_name" ]; then
            printf '%s\n' "$file"
            break
        fi
    done
)

[ -n "$selected_file" ] || exit 1

matugen image "$selected_file" -m dark || exit 1

printf '%s\n' "$selected_file" > "$CURRENT"

notify-send "Wallpaper" "$selected_name"
