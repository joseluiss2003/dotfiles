#!/bin/sh
set -eu

PERSISTENT_THEME_FILE="${HOME}/.config/swayp/current-theme"
DEFAULT_THEME="catppuccin"

THEME="${1:-}"

# Restore the persisted selection when no theme was explicitly requested.
# The runtime state is kept as a fallback for upgrades from older SwayP versions.
if [ -z "$THEME" ] && [ -f "$PERSISTENT_THEME_FILE" ]; then
    THEME="$(sed -n '1p' "$PERSISTENT_THEME_FILE")"
fi

if [ -z "$THEME" ] && [ -L "$HOME/.local/state/swayp/current/theme" ]; then
    THEME="$(basename "$(readlink "$HOME/.local/state/swayp/current/theme")")"
fi

[ -n "$THEME" ] || THEME="$DEFAULT_THEME"

BASE="${HOME}/.config/swayp/themes"
THEME_DIR="${BASE}/${THEME}"
STATE_DIR="${HOME}/.local/state/swayp/current"
PALETTE_OUTPUT="${STATE_DIR}/palette.json"
PALETTE_STAGED_OUTPUT="${STATE_DIR}/palette.json.next"

# Wallpaper transition is the only geometric reveal during a theme change.
# Keep Quickshell out of the wallpaper transition path to avoid overlapping
# center-out masks.
GENERATED_DIR="${HOME}/.config/swayp/generated"

[ -n "$THEME" ] || { printf '%s\n' "usage: swayp-theme-set <theme>" >&2; exit 2; }
[ -d "$THEME_DIR" ] || { printf 'Unknown SwayP theme: %s\n' "$THEME" >&2; exit 1; }
[ -f "$THEME_DIR/colors.toml" ] || { printf 'Theme has no colors.toml: %s\n' "$THEME" >&2; exit 1; }

mkdir -p "$STATE_DIR" "$GENERATED_DIR" "$(dirname "$PERSISTENT_THEME_FILE")"

python3 - "$THEME_DIR/colors.toml" "$PALETTE_STAGED_OUTPUT" "$GENERATED_DIR" "$THEME" <<'PY'
import json, os, sys, tomllib, colorsys, shutil, subprocess, re

colors_path, palette_path, generated_dir, theme = sys.argv[1:]
with open(colors_path, "rb") as f:
    c = tomllib.load(f)

required = [
    "background","foreground","muted","red","green","yellow",
    "blue","magenta","cyan","bright_foreground",
    "bright_red","bright_green","bright_yellow",
    "bright_blue","bright_magenta","bright_cyan"
]
missing = [k for k in required if k not in c]
if missing:
    raise SystemExit("missing theme colors: " + ", ".join(missing))

p = [c["background"], c["red"], c["green"], c["yellow"], c["blue"],
     c["magenta"], c["cyan"], c["foreground"], c["muted"],
     c["bright_red"], c["bright_green"], c["bright_yellow"],
     c["bright_blue"], c["bright_magenta"], c["bright_cyan"],
     c["bright_foreground"]]

bg, red, green, yellow, blue, magenta, cyan, fg, muted, br, bg_, by, bb, bm, bc, bfg = p
accent = c["accent"]

# Fastfetch logo palette: intentionally independent from the terminal/module palette.
# Keep one hue (the theme accent) and vary only luminance so the mark reads as
# one coherent colour family, like Omarchy's layered branding.
r, g, b = (int(accent[i:i+2], 16) / 255 for i in (1, 3, 5))
h, l, s = colorsys.rgb_to_hls(r, g, b)
logo_lightness = (0.18, 0.28, 0.40, 0.50, 0.62, 0.74)
logo_colors = []
for lightness in logo_lightness:
    logo_r, logo_g, logo_b = colorsys.hls_to_rgb(h, lightness, s)
    logo_colors.append("#{:02X}{:02X}{:02X}".format(round(logo_r * 255), round(logo_g * 255), round(logo_b * 255)))

semantic = {
    "accent": c["accent"],
    "selection": c["selection"],
    "muted": c["muted"],
    "background": c["background"],
    "dark_background": c["dark_background"],
    "darker_background": c["darker_background"],
    "lighter_background": c["lighter_background"],
    "foreground": c["foreground"],
    "dark_foreground": c["dark_foreground"],
    "light_foreground": c["light_foreground"],
    "bright_foreground": c["bright_foreground"],
    "logo": logo_colors,
}

with open(palette_path, "w") as f:
    json.dump({"colors": p, "semantic": semantic}, f, indent=2)
    f.write("\n")

surface = bg

# GTK semantic roles. Keep GTK 3/4 on the same palette authority as SwayP's
# shell, while giving each surface a distinct job.
gtk_background = bg
gtk_surface = c["lighter_background"]
gtk_surface_variant = c["dark_background"]
gtk_foreground = fg
gtk_foreground_muted = muted
gtk_accent = accent
gtk_accent_foreground = bg
gtk_selection = c["selection"]
gtk_selection_foreground = fg
gtk_headerbar = c["lighter_background"]
gtk_headerbar_foreground = fg
gtk_sidebar = c["dark_background"]
gtk_sidebar_foreground = fg
gtk_card = c["lighter_background"]
gtk_card_foreground = fg
gtk_popover = c["lighter_background"]
gtk_popover_foreground = fg
gtk_dialog = bg
gtk_dialog_foreground = fg
gtk_outline = muted
gtk_error = red
gtk_warning = yellow
gtk_success = green
gtk_info = cyan

def write(name, text):
    with open(os.path.join(generated_dir,name),"w") as f: f.write(text)

write("sway-colors.conf", f"""# Generated by SwayP theme: {theme}
set $color_bg {bg}
set $color_surface {surface}
set $color_fg {fg}
set $color_primary {accent}
set $color_primary_container {c["lighter_background"]}
set $color_secondary {c["lighter_background"]}
set $color_error {red}
set $color_outline {muted}

# Window borders + tab styling
# Keep the active window unmistakable while letting inactive tabs recede into the theme.
client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_tab_title $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_inactive $color_outline $color_bg $color_outline $color_outline $color_outline
client.unfocused $color_outline $color_bg $color_outline $color_outline $color_bg
client.urgent $color_error $color_error $color_fg $color_error $color_error
""")
write("sway-runtime-colors.sh", f"""# Generated by SwayP theme: {theme}
color_bg="{bg}"
color_surface="{surface}"
color_fg="{fg}"
color_primary="{accent}"
color_primary_container="{c["lighter_background"]}"
color_error="{red}"
color_outline="{muted}"
""")
# Generate a private YAMIS variant for Fuzzel. YAMIS SVGs use currentColor,
# so replacing that token at theme-apply time lets Fuzzel render the same
# monochrome artwork in SwayP's semantic foreground without touching the user's
# original YAMIS installation.
icons_source_candidates = [
    os.path.join(os.environ["HOME"], ".local", "share", "icons", "YAMIS"),
    os.path.join(os.environ["HOME"], ".icons", "YAMIS"),
    "/usr/share/icons/YAMIS",
    "/usr/local/share/icons/YAMIS",
]
yamis_source = next((p for p in icons_source_candidates if os.path.isdir(p)), None)
yamis_generated = os.path.join(generated_dir, "icons", "YAMIS-SwayP")
if yamis_source:
    if os.path.isdir(yamis_generated):
        shutil.rmtree(yamis_generated)
    shutil.copytree(yamis_source, yamis_generated)

    index_path = os.path.join(yamis_generated, "index.theme")
    if os.path.isfile(index_path):
        with open(index_path, "r", encoding="utf-8") as f:
            index_text = f.read()
        index_text = index_text.replace("Name=YAMIS", "Name=YAMIS-SwayP", 1)
        with open(index_path, "w", encoding="utf-8") as f:
            f.write(index_text)

    for root, _, files in os.walk(yamis_generated):
        for filename in files:
            if not filename.lower().endswith(".svg"):
                continue
            path = os.path.join(root, filename)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    svg = f.read()
                tinted = svg.replace("currentColor", fg)
                tinted = re.sub(r'class="ColorScheme-Text"', 'fill="' + fg + '"', tinted)
                if tinted != svg:
                    with open(path, "w", encoding="utf-8") as f:
                        f.write(tinted)
            except (OSError, UnicodeDecodeError):
                pass

    # GTK resolves icon themes from XDG icon directories and can cache
    # theme metadata. Install a real generated copy there rather than relying
    # on a symlink, then refresh the icon cache when the helper is available.
    icon_link_root = os.path.join(os.environ["HOME"], ".local", "share", "icons")
    icon_install = os.path.join(icon_link_root, "YAMIS-SwayP")
    os.makedirs(icon_link_root, exist_ok=True)
    if os.path.lexists(icon_install):
        if os.path.islink(icon_install) or os.path.isfile(icon_install):
            os.unlink(icon_install)
        elif os.path.isdir(icon_install):
            shutil.rmtree(icon_install)
    shutil.copytree(yamis_generated, icon_install)

    try:
        subprocess.run(
            ["gtk-update-icon-cache", "-f", "-t", icon_install],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        pass

write("fuzzel-colors.ini", f"""# Generated by SwayP theme: {theme}
[main]
icon-theme=YAMIS-SwayP

[colors]
background={surface}f7
text={fg}ff
match={accent}ff
selection={blue}ff
selection-text={fg}ff
selection-match={fg}ff
border={accent}ff

[border]
width=2
radius=0
""")
# GTK 3/4 styling uses the matching Adwaita light/dark base and overrides
# SwayP semantic colors from this same theme source.
gtk_dir = os.path.join(os.environ["HOME"], ".config")
os.makedirs(os.path.join(gtk_dir, "gtk-3.0"), exist_ok=True)
os.makedirs(os.path.join(gtk_dir, "gtk-4.0"), exist_ok=True)

gtk_mode = c.get("mode", "dark")
gtk_theme = "Adwaita-dark" if gtk_mode == "dark" else "Adwaita"
adw_theme = "adw-gtk3-dark" if gtk_mode == "dark" else "adw-gtk3"

# Arch ships the GTK3 libadwaita port as adw-gtk-theme. Prefer it when
# installed, while keeping a stock Adwaita fallback for systems that have not
# run the updated SwayP installer yet.
for theme_root in (
    os.path.join(os.environ["HOME"], ".themes"),
    os.path.join(os.environ["HOME"], ".local", "share", "themes"),
    "/usr/share/themes",
    "/usr/local/share/themes",
):
    if os.path.isdir(os.path.join(theme_root, adw_theme)):
        gtk_theme = adw_theme
        break

gtk_settings = f"""[Settings]
gtk-theme-name={gtk_theme}
gtk-icon-theme-name=YAMIS-SwayP
gtk-font-name=Sans 10
gtk-application-prefer-dark-theme={"1" if gtk_mode == "dark" else "0"}
"""
for version in ("gtk-3.0", "gtk-4.0"):
    with open(os.path.join(gtk_dir, version, "settings.ini"), "w") as f:
        f.write(gtk_settings)

gtk_css = f"""/* Generated by SwayP theme: {theme} */
@define-color accent_color {gtk_accent};
@define-color accent_bg_color {gtk_accent};
@define-color accent_fg_color {gtk_accent_foreground};

@define-color destructive_bg_color {gtk_error};
@define-color destructive_fg_color {gtk_accent_foreground};

@define-color error_bg_color {gtk_error};
@define-color error_fg_color {gtk_accent_foreground};

@define-color window_bg_color {gtk_background};
@define-color window_fg_color {gtk_foreground};

@define-color view_bg_color {gtk_background};
@define-color view_fg_color {gtk_foreground};

@define-color headerbar_bg_color {gtk_headerbar};
@define-color headerbar_fg_color {gtk_headerbar_foreground};
@define-color headerbar_backdrop_color @window_bg_color;

@define-color popover_bg_color {gtk_popover};
@define-color popover_fg_color {gtk_popover_foreground};

@define-color card_bg_color {gtk_card};
@define-color card_fg_color {gtk_card_foreground};

@define-color dialog_bg_color {gtk_dialog};
@define-color dialog_fg_color {gtk_dialog_foreground};

@define-color overview_bg_color {gtk_card};
@define-color overview_fg_color {gtk_foreground};

@define-color sidebar_bg_color {gtk_sidebar};
@define-color sidebar_fg_color {gtk_sidebar_foreground};
@define-color sidebar_backdrop_color @window_bg_color;
@define-color sidebar_border_color @window_bg_color;

@define-color secondary_sidebar_bg_color {gtk_background};
@define-color secondary_sidebar_fg_color {gtk_foreground};

/* Focused selection states */
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;

/* Backdrop/unfocused states */
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_text_color @view_fg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_base_color @window_bg_color;
@define-color theme_unfocused_selected_bg_color @accent_bg_color;
@define-color theme_unfocused_selected_fg_color @accent_fg_color;

/*
 * GTK4 / libadwaita semantic variables.
 * These mirror the roles used by modern Adwaita theming rather than
 * painting individual widgets directly.
 */
:root {{
    --accent-color: {gtk_accent};
    --accent-bg-color: {gtk_accent};
    --accent-fg-color: {gtk_accent_foreground};

    --destructive-bg-color: {gtk_error};
    --destructive-fg-color: {gtk_accent_foreground};

    --error-bg-color: {gtk_error};
    --error-fg-color: {gtk_accent_foreground};
    --error-color: {gtk_error};

    --window-bg-color: {gtk_background};
    --window-fg-color: {gtk_foreground};

    --view-bg-color: {gtk_background};
    --view-fg-color: {gtk_foreground};

    --headerbar-bg-color: {gtk_headerbar};
    --headerbar-fg-color: {gtk_headerbar_foreground};
    --headerbar-backdrop-color: @window_bg_color;

    --popover-bg-color: {gtk_popover};
    --popover-fg-color: {gtk_popover_foreground};

    --card-bg-color: {gtk_card};
    --card-fg-color: {gtk_card_foreground};

    --dialog-bg-color: {gtk_dialog};
    --dialog-fg-color: {gtk_dialog_foreground};

    --overview-bg-color: {gtk_card};
    --overview-fg-color: {gtk_foreground};

    --sidebar-bg-color: {gtk_sidebar};
    --sidebar-fg-color: {gtk_sidebar_foreground};
    --sidebar-backdrop-color: @window_bg_color;
    --sidebar-border-color: @window_bg_color;

    --warning-bg-color: {gtk_warning};
    --warning-fg-color: {gtk_background};
    --warning-color: {gtk_warning};

    --success-color: {gtk_success};
    --success-bg-color: {gtk_success};
    --success-fg-color: {gtk_background};

    --shade-color: rgba(0, 0, 0, 0.36);
}}

/*
 * SwayP compatibility layer.
 * Keep only the Nautilus selection/label adjustments that are genuinely
 * application-specific. Adwaita owns the rest of the widget hierarchy.
 */
.nautilus-window placessidebar.sidebar row.sidebar-row:selected,
.nautilus-window .navigation-sidebar row.sidebar-row:selected,
.nautilus-window .navigation-sidebar row:selected {{
    background-color: @accent_bg_color;
    color: @accent_fg_color;
}}

.nautilus-window placessidebar.sidebar row.sidebar-row:selected label,
.nautilus-window .navigation-sidebar row.sidebar-row:selected label,
.nautilus-window .navigation-sidebar row:selected label,
.nautilus-window placessidebar.sidebar row.sidebar-row:selected image,
.nautilus-window .navigation-sidebar row.sidebar-row:selected image {{
    color: @accent_fg_color;
    opacity: 1;
}}

.nautilus-window headerbar .dim-label {{
    color: @headerbar_fg_color;
    opacity: 1;
}}
"""

for version in ("gtk-3.0", "gtk-4.0"):
    with open(os.path.join(gtk_dir, version, "gtk.css"), "w") as f:
        f.write(gtk_css)

write("kitty-colors.conf", f"""# Generated by SwayP theme: {theme}
background {surface}
foreground {fg}
background_opacity 0.97

# Core UI
cursor {accent}
cursor_text_color {bg}
selection_background {blue}
selection_foreground {fg}
active_border_color {accent}
inactive_border_color {muted}
bell_border_color {red}

# Tabs
active_tab_foreground {bg}
active_tab_background {accent}
inactive_tab_foreground {muted}
inactive_tab_background {bg}
tab_bar_background {bg}

# ANSI palette
color0 {bg}
color1 {red}
color2 {green}
color3 {yellow}
color4 {blue}
color5 {magenta}
color6 {cyan}
color7 {fg}
color8 {muted}
color9 {br}
color10 {bg_}
color11 {by}
color12 {bb}
color13 {bm}
color14 {bc}
color15 {bfg}
""")
write("starship.toml", f'''# Generated by SwayP theme: {theme}
"$schema" = 'https://starship.rs/config-schema.json'
palette = "swayp"
format = """
$directory$git_branch$git_status$cmd_duration
$character
"""

[palettes.swayp]
foreground = "{fg}"
primary = "{accent}"
secondary = "{blue}"
tertiary = "{magenta}"
error = "{red}"
muted = "{muted}"

[directory]
style = "bold fg:secondary"
truncation_length = 3
truncate_to_repo = false
format = "[$path](fg:secondary) "

[git_branch]
symbol = "󰘬 "
style = "bold fg:tertiary"
format = "[$symbol$branch](fg:tertiary) "

[git_status]
style = "fg:primary"
format = "[$all_status$ahead_behind](fg:primary) "

[cmd_duration]
min_time = 2000
format = " took [$duration](fg:muted)"

[character]
success_symbol = "[❯](bold fg:primary)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:primary)"
''')

spotify_config_dir = os.path.join(os.environ["HOME"], ".config", "spotify-player")
os.makedirs(spotify_config_dir, exist_ok=True)

with open(os.path.join(spotify_config_dir, "theme.toml"), "w") as f:
    f.write(f"""# Generated by SwayP theme: {theme}
[[themes]]
name = "swayp"

[themes.palette]
background = "{bg}"
foreground = "{fg}"
black = "{c["darker_background"]}"
white = "{fg}"
red = "{red}"
green = "{green}"
yellow = "{yellow}"
blue = "{blue}"
magenta = "{magenta}"
cyan = "{cyan}"
bright_black = "{muted}"
bright_white = "{bfg}"
bright_red = "{br}"
bright_green = "{bg_}"
bright_yellow = "{by}"
bright_blue = "{bb}"
