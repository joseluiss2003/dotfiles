#!/bin/sh
set -eu

PERSISTENT_THEME_FILE="${HOME}/.config/swayp/current-theme"
DEFAULT_THEME="catppuccin"

THEME="${1:-}"

# Restore the persisted selection when no theme was explicitly requested.
# The runtime state is kept as a fallback for upgrades from older SwayP versions.
if [ -z "$THEME" ] && [ -f "$PERSISTENT_THEME_FILE" ]; then
    THEME="$(sed -n '1p' "$PERSISTENT_THEME_FILE")"
fi

if [ -z "$THEME" ] && [ -L "$HOME/.local/state/swayp/current/theme" ]; then
    THEME="$(basename "$(readlink "$HOME/.local/state/swayp/current/theme")")"
fi

[ -n "$THEME" ] || THEME="$DEFAULT_THEME"

BASE="${HOME}/.config/swayp/themes"
THEME_DIR="${BASE}/${THEME}"
STATE_DIR="${HOME}/.local/state/swayp/current"
PALETTE_OUTPUT="${STATE_DIR}/palette.json"
PALETTE_STAGED_OUTPUT="${STATE_DIR}/palette.json.next"

# Wallpaper transition is the only geometric reveal during a theme change.
# Keep Quickshell out of the wallpaper transition path to avoid overlapping
# center-out masks.
GENERATED_DIR="${HOME}/.config/swayp/generated"

[ -n "$THEME" ] || { printf '%s\n' "usage: swayp-theme-set <theme>" >&2; exit 2; }
[ -d "$THEME_DIR" ] || { printf 'Unknown SwayP theme: %s\n' "$THEME" >&2; exit 1; }
[ -f "$THEME_DIR/colors.toml" ] || { printf 'Theme has no colors.toml: %s\n' "$THEME" >&2; exit 1; }

mkdir -p "$STATE_DIR" "$GENERATED_DIR" "$(dirname "$PERSISTENT_THEME_FILE")"

python3 - "$THEME_DIR/colors.toml" "$PALETTE_STAGED_OUTPUT" "$GENERATED_DIR" "$THEME" <<'PY'
import json, os, sys, tomllib, colorsys, shutil, subprocess

colors_path, palette_path, generated_dir, theme = sys.argv[1:]
with open(colors_path, "rb") as f:
    c = tomllib.load(f)

required = [
    "background","foreground","muted","red","green","yellow",
    "blue","magenta","cyan","bright_foreground",
    "bright_red","bright_green","bright_yellow",
    "bright_blue","bright_magenta","bright_cyan"
]
missing = [k for k in required if k not in c]
if missing:
    raise SystemExit("missing theme colors: " + ", ".join(missing))

p = [c["background"], c["red"], c["green"], c["yellow"], c["blue"],
     c["magenta"], c["cyan"], c["foreground"], c["muted"],
     c["bright_red"], c["bright_green"], c["bright_yellow"],
     c["bright_blue"], c["bright_magenta"], c["bright_cyan"],
     c["bright_foreground"]]

bg, red, green, yellow, blue, magenta, cyan, fg, muted, br, bg_, by, bb, bm, bc, bfg = p
accent = c["accent"]

# Fastfetch logo palette: intentionally independent from the terminal/module palette.
# Keep one hue (the theme accent) and vary only luminance so the mark reads as
# one coherent colour family, like Omarchy's layered branding.
r, g, b = (int(accent[i:i+2], 16) / 255 for i in (1, 3, 5))
h, l, s = colorsys.rgb_to_hls(r, g, b)
logo_lightness = (0.18, 0.28, 0.40, 0.50, 0.62, 0.74)
logo_colors = []
for lightness in logo_lightness:
    logo_r, logo_g, logo_b = colorsys.hls_to_rgb(h, lightness, s)
    logo_colors.append("#{:02X}{:02X}{:02X}".format(round(logo_r * 255), round(logo_g * 255), round(logo_b * 255)))

semantic = {
    "accent": c["accent"],
    "selection": c["selection"],
    "muted": c["muted"],
    "background": c["background"],
    "dark_background": c["dark_background"],
    "darker_background": c["darker_background"],
    "lighter_background": c["lighter_background"],
    "foreground": c["foreground"],
    "dark_foreground": c["dark_foreground"],
    "light_foreground": c["light_foreground"],
    "bright_foreground": c["bright_foreground"],
    "logo": logo_colors,
}

with open(palette_path, "w") as f:
    json.dump({"colors": p, "semantic": semantic}, f, indent=2)
    f.write("\n")

surface = bg

# GTK semantic roles. Keep GTK 3/4 on the same palette authority as SwayP's
# shell, while giving each surface a distinct job.
gtk_background = bg
gtk_surface = c["lighter_background"]
gtk_surface_variant = c["dark_background"]
gtk_foreground = fg
gtk_foreground_muted = muted
gtk_accent = accent
gtk_accent_foreground = bg
gtk_selection = c["selection"]
gtk_selection_foreground = fg
gtk_headerbar = c["lighter_background"]
gtk_headerbar_foreground = fg
gtk_sidebar = c["dark_background"]
gtk_sidebar_foreground = fg
gtk_card = c["lighter_background"]
gtk_card_foreground = fg
gtk_popover = c["lighter_background"]
gtk_popover_foreground = fg
gtk_dialog = bg
gtk_dialog_foreground = fg
gtk_outline = muted
gtk_error = red
gtk_warning = yellow
gtk_success = green
gtk_info = cyan

def write(name, text):
    with open(os.path.join(generated_dir,name),"w") as f: f.write(text)

write("sway-colors.conf", f"""# Generated by SwayP theme: {theme}
set $color_bg {bg}
set $color_surface {surface}
set $color_fg {fg}
set $color_primary {accent}
set $color_primary_container {c["lighter_background"]}
set $color_secondary {c["lighter_background"]}
set $color_error {red}
set $color_outline {muted}

# Window borders + tab styling
# Keep the active window unmistakable while letting inactive tabs recede into the theme.
client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_tab_title $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_inactive $color_outline $color_bg $color_outline $color_outline $color_outline
client.unfocused $color_outline $color_bg $color_outline $color_outline $color_bg
client.urgent $color_error $color_error $color_fg $color_error $color_error
""")
write("sway-runtime-colors.sh", f"""# Generated by SwayP theme: {theme}
color_bg="{bg}"
color_surface="{surface}"
color_fg="{fg}"
color_primary="{accent}"
color_primary_container="{c["lighter_background"]}"
color_error="{red}"
color_outline="{muted}"
""")
write("fuzzel-colors.ini", f"""# Generated by SwayP theme: {theme}
[colors]
background={surface}f7
text={fg}ff
match={accent}ff
selection={blue}ff
selection-text={fg}ff
selection-match={fg}ff
border={accent}ff

[border]
width=2
radius=0
""")
# GTK 3/4 styling uses the matching Adwaita light/dark base and overrides
# SwayP semantic colors from this same theme source.
gtk_dir = os.path.join(os.environ["HOME"], ".config")
os.makedirs(os.path.join(gtk_dir, "gtk-3.0"), exist_ok=True)
os.makedirs(os.path.join(gtk_dir, "gtk-4.0"), exist_ok=True)

gtk_mode = c.get("mode", "dark")
gtk_theme = "Adwaita-dark" if gtk_mode == "dark" else "Adwaita"
gtk_settings = f"""[Settings]
gtk-theme-name={gtk_theme}
gtk-icon-theme-name=Adwaita
gtk-font-name=Sans 10
gtk-application-prefer-dark-theme={"1" if gtk_mode == "dark" else "0"}
"""
for version in ("gtk-3.0", "gtk-4.0"):
    with open(os.path.join(gtk_dir, version, "settings.ini"), "w") as f:
        f.write(gtk_settings)

gtk_css = f"""/* Generated by SwayP theme: {theme} */
@define-color swayp-bg {bg};
@define-color swayp-surface {surface};
@define-color swayp-fg {fg};
@define-color swayp-muted {muted};
@define-color swayp-accent {accent};
@define-color swayp-selection {c["selection"]};
@define-color swayp-selection-strong {c["accent"]};

@define-color gtk-background {gtk_background};
@define-color gtk-surface {gtk_surface};
@define-color gtk-surface-variant {gtk_surface_variant};
@define-color gtk-foreground {gtk_foreground};
@define-color gtk-foreground-muted {gtk_foreground_muted};
@define-color gtk-accent {gtk_accent};
@define-color gtk-accent-foreground {gtk_accent_foreground};
@define-color gtk-selection {gtk_selection};
@define-color gtk-selection-foreground {gtk_selection_foreground};
@define-color gtk-headerbar {gtk_headerbar};
@define-color gtk-headerbar-foreground {gtk_headerbar_foreground};
@define-color gtk-sidebar {gtk_sidebar};
@define-color gtk-sidebar-foreground {gtk_sidebar_foreground};
@define-color gtk-card {gtk_card};
@define-color gtk-card-foreground {gtk_card_foreground};
@define-color gtk-popover {gtk_popover};
@define-color gtk-popover-foreground {gtk_popover_foreground};
@define-color gtk-dialog {gtk_dialog};
@define-color gtk-dialog-foreground {gtk_dialog_foreground};
@define-color gtk-outline {gtk_outline};
@define-color gtk-error {gtk_error};
@define-color gtk-warning {gtk_warning};
@define-color gtk-success {gtk_success};
@define-color gtk-info {gtk_info};

window, dialog, .background {{
  background-color: @gtk-background;
  color: @gtk-foreground;
}}

popover, menu {{
  background-color: @gtk-popover;
  color: @gtk-popover-foreground;
}}
/* Nautilus GTK 4: its sidebar is a GtkListBox inside a placessidebar.
 * Target the actual widget hierarchy so the left pane follows SwayP too. */
.nautilus-window placessidebar.background,
.nautilus-window placessidebar.sidebar {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

.nautilus-window placessidebar.background > list.navigation-sidebar,
.nautilus-window placessidebar.sidebar > list.navigation-sidebar,
.nautilus-window .navigation-sidebar {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

.nautilus-window placessidebar.sidebar row.sidebar-row,
.nautilus-window .navigation-sidebar row.sidebar-row {{
  background-color: transparent;
  color: @swayp-fg;
}}

.nautilus-window placessidebar.sidebar row.sidebar-row:hover,
.nautilus-window .navigation-sidebar row.sidebar-row:hover,
.nautilus-window placessidebar.sidebar row.sidebar-row:selected,
.nautilus-window .navigation-sidebar row.sidebar-row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

/* Nautilus header/path chrome: Adwaita may apply dim-label to the
 * current-location text and inherited opacity to headerbar descendants.
 * SwayP keeps the path/title legible while retaining muted styling for
 * genuinely secondary metadata. */
.nautilus-window headerbar label,
.nautilus-window headerbar .title,
.nautilus-window headerbar .path-bar,
.nautilus-window headerbar .path-bar label,
.nautilus-window headerbar .navigation-button,
.nautilus-window headerbar button label,
.nautilus-window headerbar .dim-label {{
  color: @swayp-fg;
  opacity: 1;
}}

.nautilus-window headerbar image,
.nautilus-window headerbar button image {{
  color: @swayp-fg;
  opacity: 1;
}}

/* Keep secondary Nautilus chrome readable without making it as bright as
 * the current location. */
.nautilus-window placessidebar.sidebar row.sidebar-row label,
.nautilus-window placessidebar.sidebar row.sidebar-row image,
.nautilus-window .navigation-sidebar row.sidebar-row label,
.nautilus-window .navigation-sidebar row.sidebar-row image {{
  color: @swayp-fg;
  opacity: 0.88;
}}

.nautilus-window .view label,
.nautilus-window .view image {{
  color: @swayp-fg;
  opacity: 0.92;
}}

/* Keyboard/mouse selection: keep the theme's selection hue but give it
 * enough solid area to survive dark palettes such as Osaka Jade. */
.nautilus-window placessidebar.sidebar row.sidebar-row:selected,
.nautilus-window .navigation-sidebar row.sidebar-row:selected,
.nautilus-window .navigation-sidebar row:selected,
.sidebar row:selected,
.navigation-sidebar row:selected,
placessidebar row:selected,
.places-sidebar row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
  opacity: 1;
}}

.nautilus-window placessidebar.sidebar row.sidebar-row:selected label,
.nautilus-window .navigation-sidebar row.sidebar-row:selected label,
.nautilus-window .navigation-sidebar row:selected label,
.nautilus-window placessidebar.sidebar row.sidebar-row:selected image,
.nautilus-window .navigation-sidebar row.sidebar-row:selected image {{
  color: @swayp-fg;
  opacity: 1;
}}

.sidebar, .navigation-sidebar, placessidebar, placesview, .places-sidebar,
.navigation-sidebar.view, .navigation-sidebar > row {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

.sidebar row:selected, .navigation-sidebar row:selected, placessidebar row:selected,
.places-sidebar row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

.sidebar row:hover, .navigation-sidebar row:hover, placessidebar row:hover,
.places-sidebar row:hover {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

/* GTK FileChooser: the dialog itself is a .filechooser window.
 * Its headerbar/action area are siblings of the inner filechooser widget,
 * so target the dialog root explicitly instead of assuming they are
 * descendants of the inner filechooser CSS node. */
.filechooser,
.filechooser.background {{
  background-color: @swayp-bg;
  color: @swayp-fg;
}}

.filechooser headerbar,
.filechooser headerbar.background,
.filechooser .titlebar,
.filechooser toolbar,
.filechooser .toolbar,
.filechooser .path-bar,
.filechooser .location-bar,
.filechooser .dialog-action-area,
.filechooser .dialog-action-box {{
  background-color: @swayp-surface;
  background-image: none;
  color: @swayp-fg;
  border-color: @swayp-muted;
  box-shadow: none;
}}

.filechooser button,
.filechooser button.flat,
.filechooser button.suggested-action,
.filechooser button.default,
.filechooser combobox,
.filechooser combobox button,
.filechooser entry,
.filechooser spinbutton {{
  background-color: @swayp-surface;
  background-image: none;
  color: @swayp-fg;
  border-color: @swayp-muted;
  border-image: none;
  box-shadow: none;
}}

.filechooser button.suggested-action,
.filechooser button.default {{
  background-color: @swayp-accent;
  color: @swayp-bg;
}}

.filechooser button:hover,
.filechooser button:focus,
.filechooser button:checked,
.filechooser button.flat:hover,
.filechooser button.flat:focus,
.filechooser combobox button:hover {{
  background-color: @swayp-selection;
  background-image: none;
  color: @swayp-fg;
}}

.filechooser entry:focus {{
  background-color: @swayp-surface;
  background-image: none;
  color: @swayp-fg;
  border-color: @swayp-accent;
  box-shadow: none;
}}

.filechooser .path-bar button,
.filechooser .location-bar button {{
  background-color: @swayp-surface;
  background-image: none;
  color: @swayp-fg;
  border-image: none;
}}

filechooser,
filechooser .view,
filechooser treeview,
filechooser treeview.view,
filechooser iconview,
filechooser list,
filechooser row {{
  background-color: @swayp-bg;
  color: @swayp-fg;
}}

filechooser .sidebar,
filechooser .navigation-sidebar,
filechooser placessidebar {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

filechooser treeview.view:selected,
filechooser iconview:selected,
filechooser row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

headerbar, .titlebar, .toolbar {{
  background-color: @gtk-headerbar;
  color: @gtk-headerbar-foreground;
  border-color: transparent;
  box-shadow: none;
}}

/* Semantic GTK surfaces: window, view, sidebar, card, popover and dialog
 * each get a distinct role while remaining derived from the SwayP palette. */
.card,
.card > box,
frame.card {{
  background-color: @gtk-card;
  color: @gtk-card-foreground;
  background-image: none;
}}

popover.background,
popover.background > contents,
popover > contents {{
  background-color: @gtk-popover;
  color: @gtk-popover-foreground;
}}

dialog,
dialog.background,
.dialog {{
  background-color: @gtk-dialog;
  color: @gtk-dialog-foreground;
}}

.sidebar,
.navigation-sidebar,
placessidebar,
.places-sidebar {{
  background-color: @gtk-sidebar;
  color: @gtk-sidebar-foreground;
}}
button, entry, spinbutton, combobox {{
  background-color: @gtk-surface-variant;
  background-image: none;
  color: @gtk-foreground;
  border-color: transparent;
  border-image: none;
  box-shadow: none;
}}

/* GTK3 content surfaces: keep viewports and model views on the
 * SwayP background instead of letting Adwaita's light content surface leak
 * through applications such as virt-manager. */
viewport,
scrolledwindow,
scrolledwindow > viewport,
treeview,
treeview.view,
iconview,
iconview.view,
textview,
textview.view,
.view,
.content-view,
list,
listview,
row,
frame {{
  background-color: @swayp-bg;
  background-image: none;
  color: @swayp-fg;
}}

viewport.view,
scrolledwindow.viewport,
treeview.view {{
  background-color: @swayp-bg;
  color: @swayp-fg;
}}

treeview.view:selected,
iconview.view:selected,
list row:selected,
row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

/* GTK3 application chrome: menus, toolbars and split-pane surfaces. */
menubar,
menubar > item,
menubar > item > submenu,
toolbar,
toolbar > button,
toolbar > toolitem,
statusbar,
statusbar > frame,
paned,
paned > separator,
expander,
searchbar,
searchbar > revealer,
headerbar,
headerbar.background {{
  background-color: @swayp-surface;
  background-image: none;
  color: @swayp-fg;
  border-color: transparent;
  box-shadow: none;
}}

menubar > item:hover,
menubar > item:focus,
toolbar > button:hover,
toolbar > button:focus,
toolbar > button:checked {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

toolbar button image,
menubar image,
toolbar image {{
  color: @swayp-fg;
}}

notebook,
frame {{
  color: @swayp-fg;
}}

button:hover, button:focus, button:checked, modelbutton:hover, menuitem:hover,
entry:focus, selection, *:selected {{
  background-color: @swayp-selection;
  background-image: none;
  color: @swayp-fg;
}}

button.suggested-action, button.default {{
  background-color: @swayp-accent;
  color: @swayp-bg;
}}

dialog {{
  color: @swayp-fg;
}}

dialog > box,
dialog .dialog-action-area {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}
link, .link {{ color: @swayp-accent; }}
tooltip, .tooltip {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}
separator {{ background-color: alpha(@gtk-outline, 0.45); }}
"""
for version in ("gtk-3.0", "gtk-4.0"):
    with open(os.path.join(gtk_dir, version, "gtk.css"), "w") as f:
        f.write(gtk_css)

write("kitty-colors.conf", f"""# Generated by SwayP theme: {theme}
background {surface}
foreground {fg}
background_opacity 0.97

# Core UI
cursor {accent}
cursor_text_color {bg}
selection_background {blue}
selection_foreground {fg}
active_border_color {accent}
inactive_border_color {muted}
bell_border_color {red}

# Tabs
active_tab_foreground {bg}
active_tab_background {accent}
inactive_tab_foreground {muted}
inactive_tab_background {bg}
tab_bar_background {bg}

# ANSI palette
color0 {bg}
color1 {red}
color2 {green}
color3 {yellow}
color4 {blue}
color5 {magenta}
color6 {cyan}
color7 {fg}
color8 {muted}
color9 {br}
color10 {bg_}
color11 {by}
color12 {bb}
color13 {bm}
color14 {bc}
color15 {bfg}
""")
write("starship.toml", f'''# Generated by SwayP theme: {theme}
"$schema" = 'https://starship.rs/config-schema.json'
palette = "swayp"
format = """
$directory$git_branch$git_status$cmd_duration
$character
"""

[palettes.swayp]
foreground = "{fg}"
primary = "{accent}"
secondary = "{blue}"
tertiary = "{magenta}"
error = "{red}"
muted = "{muted}"

[directory]
style = "bold fg:secondary"
truncation_length = 3
truncate_to_repo = false
format = "[$path](fg:secondary) "

[git_branch]
symbol = "󰘬 "
style = "bold fg:tertiary"
format = "[$symbol$branch](fg:tertiary) "

[git_status]
style = "fg:primary"
format = "[$all_status$ahead_behind](fg:primary) "

[cmd_duration]
min_time = 2000
format = " took [$duration](fg:muted)"

[character]
success_symbol = "[❯](bold fg:primary)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:primary)"
''')

spotify_config_dir = os.path.join(os.environ["HOME"], ".config", "spotify-player")
os.makedirs(spotify_config_dir, exist_ok=True)

with open(os.path.join(spotify_config_dir, "theme.toml"), "w") as f:
    f.write(f"""# Generated by SwayP theme: {theme}
[[themes]]
name = "swayp"

[themes.palette]
background = "{bg}"
foreground = "{fg}"
black = "{c["darker_background"]}"
white = "{fg}"
red = "{red}"
green = "{green}"
yellow = "{yellow}"
blue = "{blue}"
magenta = "{magenta}"
cyan = "{cyan}"
bright_black = "{muted}"
bright_white = "{bfg}"
bright_red = "{br}"
bright_green = "{bg_}"
bright_yellow = "{by}"
bright_blue = "{bb}"
bright_magenta = "{bm}"
bright_cyan = "{bc}"

[themes.component_style]
block_title = {{ fg = "{accent}", modifiers = ["Bold"] }}
border = {{ fg = "{muted}" }}
playback_status = {{ fg = "{green}", modifiers = ["Bold"] }}
playback_track = {{ fg = "{bfg}", modifiers = ["Bold"] }}
playback_artists = {{ fg = "{accent}", modifiers = ["Bold"] }}
playback_album = {{ fg = "{muted}" }}
playback_genres = {{ fg = "{muted}", modifiers = ["Italic"] }}
playback_metadata = {{ fg = "{muted}", modifiers = ["Dim"] }}
playback_progress_bar = {{ fg = "{accent}", bg = "{c["lighter_background"]}" }}
playback_progress_bar_unfilled = {{ bg = "{c["lighter_background"]}" }}
current_playing = {{ fg = "{green}", modifiers = ["Bold"] }}
page_desc = {{ fg = "{accent}", modifiers = ["Bold"] }}
playlist_desc = {{ fg = "{muted}", modifiers = ["Dim"] }}
table_header = {{ fg = "{accent}", modifiers = ["Bold"] }}
selection = {{ fg = "{fg}", bg = "{c["selection"]}", modifiers = ["Bold"] }}
secondary_row = {{ fg = "{muted}" }}
like = {{ fg = "{green}" }}
lyrics_played = {{ fg = "{muted}", modifiers = ["Dim"] }}
lyrics_playing = {{ fg = "{green}", modifiers = ["Bold"] }}
visualization = {{ low = "{blue}", mid = "{accent}", high = "{green}" }}
""")

fastfetch_logo_template = os.path.join(os.environ["HOME"], ".config", "swayp", "branding", "swayp-fastfetch.txt")
fastfetch_logo = fastfetch_logo_template

# The Fastfetch mark is plain ASCII. Its $1 token is resolved by Fastfetch
# against the active theme accent, so the exact same artwork follows themes
# without rasterization or image-cache issues.
write("fastfetch.jsonc", f'''{{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {{
    "type": "file",
    "source": "{fastfetch_logo}",
    "color": {{
      "1": "{fg}",
