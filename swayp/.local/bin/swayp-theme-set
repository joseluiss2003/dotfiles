#!/bin/sh
set -eu

PERSISTENT_THEME_FILE="${HOME}/.config/swayp/current-theme"
DEFAULT_THEME="catppuccin"

THEME="${1:-}"

# Restore the persisted selection when no theme was explicitly requested.
# The runtime state is kept as a fallback for upgrades from older SwayP versions.
if [ -z "$THEME" ] && [ -f "$PERSISTENT_THEME_FILE" ]; then
    THEME="$(sed -n '1p' "$PERSISTENT_THEME_FILE")"
fi

if [ -z "$THEME" ] && [ -L "$HOME/.local/state/swayp/current/theme" ]; then
    THEME="$(basename "$(readlink "$HOME/.local/state/swayp/current/theme")")"
fi

[ -n "$THEME" ] || THEME="$DEFAULT_THEME"

BASE="${HOME}/.config/swayp/themes"
THEME_DIR="${BASE}/${THEME}"
STATE_DIR="${HOME}/.local/state/swayp/current"
PALETTE_OUTPUT="${STATE_DIR}/palette.json"
PALETTE_STAGED_OUTPUT="${STATE_DIR}/palette.json.next"

# Wallpaper transition is the only geometric reveal during a theme change.
# Keep Quickshell out of the wallpaper transition path to avoid overlapping
# center-out masks.
GENERATED_DIR="${HOME}/.config/swayp/generated"

[ -n "$THEME" ] || { printf '%s\n' "usage: swayp-theme-set <theme>" >&2; exit 2; }
[ -d "$THEME_DIR" ] || { printf 'Unknown SwayP theme: %s\n' "$THEME" >&2; exit 1; }
[ -f "$THEME_DIR/colors.toml" ] || { printf 'Theme has no colors.toml: %s\n' "$THEME" >&2; exit 1; }

mkdir -p "$STATE_DIR" "$GENERATED_DIR" "$(dirname "$PERSISTENT_THEME_FILE")"

python3 - "$THEME_DIR/colors.toml" "$PALETTE_STAGED_OUTPUT" "$GENERATED_DIR" "$THEME" <<'PY'
import json, os, sys, tomllib, colorsys, shutil, subprocess

colors_path, palette_path, generated_dir, theme = sys.argv[1:]
with open(colors_path, "rb") as f:
    c = tomllib.load(f)

required = [
    "background","foreground","muted","red","green","yellow",
    "blue","magenta","cyan","bright_foreground",
    "bright_red","bright_green","bright_yellow",
    "bright_blue","bright_magenta","bright_cyan"
]
missing = [k for k in required if k not in c]
if missing:
    raise SystemExit("missing theme colors: " + ", ".join(missing))

p = [c["background"], c["red"], c["green"], c["yellow"], c["blue"],
     c["magenta"], c["cyan"], c["foreground"], c["muted"],
     c["bright_red"], c["bright_green"], c["bright_yellow"],
     c["bright_blue"], c["bright_magenta"], c["bright_cyan"],
     c["bright_foreground"]]

bg, red, green, yellow, blue, magenta, cyan, fg, muted, br, bg_, by, bb, bm, bc, bfg = p
accent = c["accent"]

# Fastfetch logo palette: intentionally independent from the terminal/module palette.
# Keep one hue (the theme accent) and vary only luminance so the mark reads as
# one coherent colour family, like Omarchy's layered branding.
r, g, b = (int(accent[i:i+2], 16) / 255 for i in (1, 3, 5))
h, l, s = colorsys.rgb_to_hls(r, g, b)
logo_lightness = (0.18, 0.28, 0.40, 0.50, 0.62, 0.74)
logo_colors = []
for lightness in logo_lightness:
    logo_r, logo_g, logo_b = colorsys.hls_to_rgb(h, lightness, s)
    logo_colors.append("#{:02X}{:02X}{:02X}".format(round(logo_r * 255), round(logo_g * 255), round(logo_b * 255)))

semantic = {
    "accent": c["accent"],
    "selection": c["selection"],
    "muted": c["muted"],
    "background": c["background"],
    "dark_background": c["dark_background"],
    "darker_background": c["darker_background"],
    "lighter_background": c["lighter_background"],
    "foreground": c["foreground"],
    "dark_foreground": c["dark_foreground"],
    "light_foreground": c["light_foreground"],
    "bright_foreground": c["bright_foreground"],
    "logo": logo_colors,
}

with open(palette_path, "w") as f:
    json.dump({"colors": p, "semantic": semantic}, f, indent=2)
    f.write("\n")

surface = bg

def write(name, text):
    with open(os.path.join(generated_dir,name),"w") as f: f.write(text)

write("sway-colors.conf", f"""# Generated by SwayP theme: {theme}
set $color_bg {bg}
set $color_surface {surface}
set $color_fg {fg}
set $color_primary {accent}
set $color_primary_container {c["lighter_background"]}
set $color_secondary {c["lighter_background"]}
set $color_error {red}
set $color_outline {muted}

# Window borders + tab styling
# Keep the active window unmistakable while letting inactive tabs recede into the theme.
client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_tab_title $color_primary $color_primary_container $color_fg $color_primary $color_primary
client.focused_inactive $color_outline $color_bg $color_outline $color_outline $color_outline
client.unfocused $color_outline $color_bg $color_outline $color_outline $color_bg
client.urgent $color_error $color_error $color_fg $color_error $color_error
""")
write("sway-runtime-colors.sh", f"""# Generated by SwayP theme: {theme}
color_bg="{bg}"
color_surface="{surface}"
color_fg="{fg}"
color_primary="{accent}"
color_primary_container="{c["lighter_background"]}"
color_error="{red}"
color_outline="{muted}"
""")
write("fuzzel-colors.ini", f"""# Generated by SwayP theme: {theme}
[colors]
background={surface}f7
text={fg}ff
match={accent}ff
selection={blue}ff
selection-text={fg}ff
selection-match={fg}ff
border={accent}ff

[border]
width=2
radius=0
""")
# GTK 3/4 styling uses Adwaita as the native base and overrides
# SwayP semantic colors from this same theme source.
gtk_dir = os.path.join(os.environ["HOME"], ".config")
os.makedirs(os.path.join(gtk_dir, "gtk-3.0"), exist_ok=True)
os.makedirs(os.path.join(gtk_dir, "gtk-4.0"), exist_ok=True)

gtk_settings = f"""[Settings]
gtk-theme-name=Adwaita
gtk-icon-theme-name=Adwaita
gtk-font-name=Sans 10
gtk-application-prefer-dark-theme={"1" if c.get("mode", "dark") == "dark" else "0"}
"""
for version in ("gtk-3.0", "gtk-4.0"):
    with open(os.path.join(gtk_dir, version, "settings.ini"), "w") as f:
        f.write(gtk_settings)

gtk_css = f"""/* Generated by SwayP theme: {theme} */
@define-color swayp-bg {bg};
@define-color swayp-surface {surface};
@define-color swayp-fg {fg};
@define-color swayp-muted {muted};
@define-color swayp-accent {accent};
@define-color swayp-selection {c["selection"]};

window, dialog, popover, menu, .background {{
  background-color: @swayp-bg;
  color: @swayp-fg;
}}
/* Nautilus GTK 4: its sidebar is a GtkListBox inside a placessidebar.
 * Target the actual widget hierarchy so the left pane follows SwayP too. */
.nautilus-window placessidebar.background,
.nautilus-window placessidebar.sidebar {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

.nautilus-window placessidebar.background > list.navigation-sidebar,
.nautilus-window placessidebar.sidebar > list.navigation-sidebar,
.nautilus-window .navigation-sidebar {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

.nautilus-window placessidebar.sidebar row.sidebar-row,
.nautilus-window .navigation-sidebar row.sidebar-row {{
  background-color: transparent;
  color: @swayp-fg;
}}

.nautilus-window placessidebar.sidebar row.sidebar-row:hover,
.nautilus-window .navigation-sidebar row.sidebar-row:hover,
.nautilus-window placessidebar.sidebar row.sidebar-row:selected,
.nautilus-window .navigation-sidebar row.sidebar-row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

.sidebar, .navigation-sidebar, placessidebar, placesview, .places-sidebar,
.navigation-sidebar.view, .navigation-sidebar > row {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}

.sidebar row:selected, .navigation-sidebar row:selected, placessidebar row:selected,
.places-sidebar row:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

.sidebar row:hover, .navigation-sidebar row:hover, placessidebar row:hover,
.places-sidebar row:hover {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}

headerbar, .titlebar, .toolbar {{
  background-color: @swayp-surface;
  color: @swayp-fg;
  border-color: @swayp-muted;
  box-shadow: none;
}}
button, entry, spinbutton, combobox, notebook, frame, list, row, .view {{
  color: @swayp-fg;
}}
button:hover, button:focus, button:checked, modelbutton:hover, menuitem:hover,
entry:focus, selection, *:selected {{
  background-color: @swayp-selection;
  color: @swayp-fg;
}}
link, .link {{ color: @swayp-accent; }}
tooltip, .tooltip {{
  background-color: @swayp-surface;
  color: @swayp-fg;
}}
separator {{ background-color: @swayp-muted; }}
"""
for version in ("gtk-3.0", "gtk-4.0"):
    with open(os.path.join(gtk_dir, version, "gtk.css"), "w") as f:
        f.write(gtk_css)

write("kitty-colors.conf", f"""# Generated by SwayP theme: {theme}
background {surface}
foreground {fg}
background_opacity 0.97

# Core UI
cursor {accent}
cursor_text_color {bg}
selection_background {blue}
selection_foreground {fg}
active_border_color {accent}
inactive_border_color {muted}
bell_border_color {red}

# Tabs
active_tab_foreground {bg}
active_tab_background {accent}
inactive_tab_foreground {muted}
inactive_tab_background {bg}
tab_bar_background {bg}

# ANSI palette
color0 {bg}
color1 {red}
color2 {green}
color3 {yellow}
color4 {blue}
color5 {magenta}
color6 {cyan}
color7 {fg}
color8 {muted}
color9 {br}
color10 {bg_}
color11 {by}
color12 {bb}
color13 {bm}
color14 {bc}
color15 {bfg}
""")
write("starship.toml", f'''# Generated by SwayP theme: {theme}
"$schema" = 'https://starship.rs/config-schema.json'
palette = "swayp"
format = """
$directory$git_branch$git_status$cmd_duration
$character
"""

[palettes.swayp]
foreground = "{fg}"
primary = "{accent}"
secondary = "{blue}"
tertiary = "{magenta}"
error = "{red}"
muted = "{muted}"

[directory]
style = "bold fg:secondary"
truncation_length = 3
truncate_to_repo = false
format = "[$path](fg:secondary) "

[git_branch]
symbol = "󰘬 "
style = "bold fg:tertiary"
format = "[$symbol$branch](fg:tertiary) "

[git_status]
style = "fg:primary"
format = "[$all_status$ahead_behind](fg:primary) "

[cmd_duration]
min_time = 2000
format = " took [$duration](fg:muted)"

[character]
success_symbol = "[❯](bold fg:primary)"
error_symbol = "[❯](bold fg:error)"
vimcmd_symbol = "[❮](bold fg:primary)"
''')

spotify_config_dir = os.path.join(os.environ["HOME"], ".config", "spotify-player")
os.makedirs(spotify_config_dir, exist_ok=True)

with open(os.path.join(spotify_config_dir, "theme.toml"), "w") as f:
    f.write(f"""# Generated by SwayP theme: {theme}
[[themes]]
name = "swayp"

[themes.palette]
background = "{bg}"
foreground = "{fg}"
black = "{c["darker_background"]}"
white = "{fg}"
red = "{red}"
green = "{green}"
yellow = "{yellow}"
blue = "{blue}"
magenta = "{magenta}"
cyan = "{cyan}"
bright_black = "{muted}"
bright_white = "{bfg}"
bright_red = "{br}"
bright_green = "{bg_}"
bright_yellow = "{by}"
bright_blue = "{bb}"
bright_magenta = "{bm}"
bright_cyan = "{bc}"

[themes.component_style]
block_title = {{ fg = "{accent}", modifiers = ["Bold"] }}
border = {{ fg = "{muted}" }}
playback_status = {{ fg = "{green}", modifiers = ["Bold"] }}
playback_track = {{ fg = "{bfg}", modifiers = ["Bold"] }}
playback_artists = {{ fg = "{accent}", modifiers = ["Bold"] }}
playback_album = {{ fg = "{muted}" }}
playback_genres = {{ fg = "{muted}", modifiers = ["Italic"] }}
playback_metadata = {{ fg = "{muted}", modifiers = ["Dim"] }}
playback_progress_bar = {{ fg = "{accent}", bg = "{c["lighter_background"]}" }}
playback_progress_bar_unfilled = {{ bg = "{c["lighter_background"]}" }}
current_playing = {{ fg = "{green}", modifiers = ["Bold"] }}
page_desc = {{ fg = "{accent}", modifiers = ["Bold"] }}
playlist_desc = {{ fg = "{muted}", modifiers = ["Dim"] }}
table_header = {{ fg = "{accent}", modifiers = ["Bold"] }}
selection = {{ fg = "{fg}", bg = "{c["selection"]}", modifiers = ["Bold"] }}
secondary_row = {{ fg = "{muted}" }}
like = {{ fg = "{green}" }}
lyrics_played = {{ fg = "{muted}", modifiers = ["Dim"] }}
lyrics_playing = {{ fg = "{green}", modifiers = ["Bold"] }}
visualization = {{ low = "{blue}", mid = "{accent}", high = "{green}" }}
""")

fastfetch_logo_template = os.path.join(os.environ["HOME"], ".config", "swayp", "branding", "swayp-fastfetch.txt")
fastfetch_logo = fastfetch_logo_template

# The Fastfetch mark is plain ASCII. Its $1 token is resolved by Fastfetch
# against the active theme accent, so the exact same artwork follows themes
# without rasterization or image-cache issues.
write("fastfetch.jsonc", f'''{{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {{
    "type": "file",
    "source": "{fastfetch_logo}",
    "color": {{
      "1": "{fg}",
      "2": "{fg}",
      "3": "{fg}",
      "4": "{fg}",
      "5": "{fg}",
      "6": "{fg}"
    }},
    "padding": {{ "top": 1, "right": 6, "left": 1 }}
  }},
  "display": {{
    "disableLinewrap": true,
    "color": {{ "keys": "{fg}", "output": "{fg}", "separator": "{muted}" }},
    "key": {{ "width": 14, "type": "string" }}
  }},
  "modules": [
    "break",
    {{ "type": "custom", "outputColor": "{fg}", "format": "┌────────────────────── Hardware ───────────────────┐" }},
    {{ "type": "host", "key": " PC", "keyColor": "{blue}" }},
    {{ "type": "cpu", "key": " CPU", "keyColor": "{yellow}" }},
    {{ "type": "gpu", "key": " GPU", "keyColor": "{blue}" }},
    {{ "type": "memory", "key": " Memoria", "keyColor": "{green}" }},
    {{ "type": "disk", "key": " Disco", "keyColor": "{cyan}" }},
    {{ "type": "custom", "outputColor": "{fg}", "format": "└──────────────────────────────────────────────────┘" }},
    "break",
    {{ "type": "custom", "outputColor": "{fg}", "format": "┌────────────────────── Software ───────────────────┐" }},
    {{ "type": "os", "key": " OS", "keyColor": "{blue}" }},
    {{ "type": "kernel", "key": " Kernel", "keyColor": "{magenta}" }},
    {{ "type": "de", "key": " Entorno", "keyColor": "{blue}" }},
    {{ "type": "shell", "key": " Shell", "keyColor": "{green}" }},
    {{ "type": "terminal", "key": " Terminal", "keyColor": "{cyan}" }},
    {{ "type": "packages", "key": " Paquetes", "keyColor": "{yellow}" }},
    {{ "type": "custom", "outputColor": "{fg}", "format": "└──────────────────────────────────────────────────┘" }},
    "break",
    {{ "type": "colors", "symbol": "block", "block": {{ "width": 3, "range": [0, 15] }} }}
  ]
}}''')
PY


ln -sfn "$THEME_DIR" "$STATE_DIR/theme"
printf '%s\n' "$THEME" > "$PERSISTENT_THEME_FILE"

# Remove state files from pre-static-theme versions.
rm -f "$STATE_DIR/theme.name" "$STATE_DIR/palette-source"

# Each theme owns a default wallpaper named 01. Prefer it explicitly so
# adding another file cannot silently change the default. The first supported
# image remains a compatibility fallback for older pools.
THEME_WALLPAPER_DIR="$HOME/.config/swayp/wallpapers/$THEME"
DEFAULT_WALLPAPER=""
if [ -d "$THEME_WALLPAPER_DIR" ]; then
    for extension in jpg jpeg png webp svg; do
        if [ -f "$THEME_WALLPAPER_DIR/01.$extension" ]; then
            DEFAULT_WALLPAPER="$THEME_WALLPAPER_DIR/01.$extension"
            break
        fi
    done

    if [ -z "$DEFAULT_WALLPAPER" ]; then
        DEFAULT_WALLPAPER="$(
            find "$THEME_WALLPAPER_DIR" -maxdepth 1 -type f \
                \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.svg' \) \
                -print 2>/dev/null | sort | head -n 1
        )"
    fi
fi

# Start the fast wallpaper fade and palette transition together.
# Do not wait for awww: its CLI may remain attached to the transition request,
# which would make the palette update visibly lag behind the wallpaper.
#
# Fork awww first, then swap the staged palette immediately. Both transitions
# therefore begin from the same shell turn; the wallpaper fade is intentionally
# matches the Quickshell palette transition duration exactly.
# Apply the staged palette regardless of whether this theme has a
# curated wallpaper pool. Quickshell must not depend on a wallpaper existing.
# This is especially important for new themes while their wallpaper pools are
# still being curated.
if [ -f "$PALETTE_STAGED_OUTPUT" ]; then
    mv -f "$PALETTE_STAGED_OUTPUT" "$PALETTE_OUTPUT"

    if [ -n "$DEFAULT_WALLPAPER" ] && command -v awww >/dev/null 2>&1; then
        awww img \
            --transition-type fade \
            --transition-fps 240 \
            --transition-duration 0.50 \
            "$DEFAULT_WALLPAPER" >/dev/null 2>&1 &
        ln -sfn "$DEFAULT_WALLPAPER" "$STATE_DIR/background"
        printf '%s\n' "$DEFAULT_WALLPAPER" > "$HOME/.local/state/wallpaper/current"

        # Give awww a tiny head start so its compositor-side fade begins just
        # before Quickshell repaints the shell palette.
        sleep 0.019
    fi

    # Push the exact new palette directly into the running Quickshell instead
    # of waiting for FileView's filesystem watcher.
    if command -v qs >/dev/null 2>&1; then
        PALETTE_B64="$(base64 -w0 "$PALETTE_OUTPUT")"
        SHELL_B64="$(base64 -w0 "$THEME_DIR/theme.toml")"
        qs ipc call shell applyTheme "$PALETTE_B64" "$SHELL_B64" >/dev/null 2>&1 || true
    fi
fi

# Apply all runtime application colors at the beginning of the visual
# transition. Kitty and Sway must move with the wallpaper and Quickshell,
# not after the 500 ms reveal has already finished.

if command -v kitty >/dev/null 2>&1 && [ -f "$GENERATED_DIR/kitty-colors.conf" ]; then
    # Kitty creates one control socket per running instance. Discover the
    # sockets directly so every Kitty process gets the new palette.
    for KITTY_SOCKET_PATH in /tmp/swayp-kitty.sock-*; do
        [ -S "$KITTY_SOCKET_PATH" ] || continue
        kitty @ --to "unix:$KITTY_SOCKET_PATH" set-colors --all "$GENERATED_DIR/kitty-colors.conf" >/dev/null 2>&1 || true
    done
fi

if command -v swaymsg >/dev/null 2>&1; then
    SWAY_RUNTIME_COLORS="$GENERATED_DIR/sway-runtime-colors.sh"
    if [ -f "$SWAY_RUNTIME_COLORS" ]; then
        # shellcheck disable=SC1090
        . "$SWAY_RUNTIME_COLORS"
        swaymsg "client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary" >/dev/null 2>&1 || true
        swaymsg "client.focused_tab_title $color_primary $color_primary_container $color_fg $color_primary $color_primary" >/dev/null 2>&1 || true
        swaymsg "client.focused_inactive $color_outline $color_primary_container $color_fg $color_outline $color_outline" >/dev/null 2>&1 || true
        swaymsg "client.unfocused $color_outline $color_bg $color_fg $color_outline $color_bg" >/dev/null 2>&1 || true
        swaymsg "client.urgent $color_error $color_error $color_fg $color_error $color_error" >/dev/null 2>&1 || true
    fi
fi

printf 'SwayP theme applied: %s\n' "$THEME"
