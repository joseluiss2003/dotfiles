""")

fastfetch_logo_template = os.path.join(os.environ["HOME"], ".config", "swayp", "branding", "swayp-fastfetch.txt")
fastfetch_logo = fastfetch_logo_template

# The Fastfetch mark is plain ASCII. Its $1 token is resolved by Fastfetch
# against the active theme accent, so the exact same artwork follows themes
# without rasterization or image-cache issues.
write("fastfetch.jsonc", f'''{{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {{
    "type": "file",
    "source": "{fastfetch_logo}",
    "color": {{
      "1": "{fg}",
      "2": "{fg}",
      "3": "{fg}",
      "4": "{fg}",
      "5": "{fg}",
      "6": "{fg}"
    }},
    "padding": {{ "top": 1, "right": 6, "left": 1 }}
  }},
  "display": {{
    "disableLinewrap": true,
    "color": {{ "keys": "{fg}", "output": "{fg}", "separator": "{muted}" }},
    "key": {{ "width": 14, "type": "string" }}
  }},
  "modules": [
    "break",
    {{ "type": "custom", "outputColor": "{fg}", "format": "┌────────────────────── Hardware ───────────────────┐" }},
    {{ "type": "host", "key": " PC", "keyColor": "{blue}" }},
    {{ "type": "cpu", "key": " CPU", "keyColor": "{yellow}" }},
    {{ "type": "gpu", "key": " GPU", "keyColor": "{blue}" }},
    {{ "type": "memory", "key": " Memoria", "keyColor": "{green}" }},
    {{ "type": "disk", "key": " Disco", "keyColor": "{cyan}" }},
    {{ "type": "custom", "outputColor": "{fg}", "format": "└──────────────────────────────────────────────────┘" }},
    "break",
    {{ "type": "custom", "outputColor": "{fg}", "format": "┌────────────────────── Software ───────────────────┐" }},
    {{ "type": "os", "key": " OS", "keyColor": "{blue}" }},
    {{ "type": "kernel", "key": " Kernel", "keyColor": "{magenta}" }},
    {{ "type": "de", "key": " Entorno", "keyColor": "{blue}" }},
    {{ "type": "shell", "key": " Shell", "keyColor": "{green}" }},
    {{ "type": "terminal", "key": " Terminal", "keyColor": "{cyan}" }},
    {{ "type": "packages", "key": " Paquetes", "keyColor": "{yellow}" }},
    {{ "type": "custom", "outputColor": "{fg}", "format": "└──────────────────────────────────────────────────┘" }},
    "break",
    {{ "type": "colors", "symbol": "block", "block": {{ "width": 3, "range": [0, 15] }} }}
  ]
}}''')
PY

# The generated CSS is the semantic GTK layer; settings.ini selects
# the matching Adwaita base and color-scheme for applications that honor it.
# GTK loads the user gtk.css when the application initializes. Ask the
# session-wide GTK settings to reload the active theme so already-running
# GTK applications can recompute their styles without a Sway reload.
if command -v gsettings >/dev/null 2>&1; then
    # The GTK settings were just generated above; read them back here instead
    # of relying on Python-only variables that do not exist in this shell.
    GTK_THEME="$(sed -n 's/^gtk-theme-name=//p' "$HOME/.config/gtk-3.0/settings.ini" | sed -n '1p')"
    GTK_PREFER_DARK="$(sed -n 's/^gtk-application-prefer-dark-theme=//p' "$HOME/.config/gtk-3.0/settings.ini" | sed -n '1p')"

    GTK_TARGET_SCHEME="prefer-dark"
    GTK_ALT_THEME="Adwaita"
    [ "$GTK_PREFER_DARK" = "1" ] || {
        GTK_TARGET_SCHEME="prefer-light"
        GTK_ALT_THEME="Adwaita-dark"
    }

    # Prefer the modern adw-gtk3 base when installed, matching Noctalia's
    # GTK integration. Fall back to the stock Adwaita theme otherwise.
    if [ "$GTK_PREFER_DARK" = "1" ]; then
        GTK_TARGET_THEME="adw-gtk3-dark"
    else
        GTK_TARGET_THEME="adw-gtk3"
    fi

    if [ -d "$HOME/.themes/$GTK_TARGET_THEME" ] ||
       [ -d "$HOME/.local/share/themes/$GTK_TARGET_THEME" ] ||
       [ -d "/usr/share/themes/$GTK_TARGET_THEME" ] ||
       [ -d "/usr/local/share/themes/$GTK_TARGET_THEME" ]; then
        GTK_THEME="$GTK_TARGET_THEME"
    fi

    CURRENT_GTK_THEME="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || true)"
    if [ "$CURRENT_GTK_THEME" = "'$GTK_THEME'" ]; then
        gsettings set org.gnome.desktop.interface gtk-theme "$GTK_ALT_THEME" >/dev/null 2>&1 || true
    fi

    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" >/dev/null 2>&1 || true
    # GTK/GNOME reads the active icon theme from GSettings independently of
    # gtk-3.0/settings.ini. Keep it synchronized with the generated YAMIS theme.
    if [ -d "$HOME/.local/share/icons/YAMIS-SwayP" ]; then
        gsettings set org.gnome.desktop.interface icon-theme "YAMIS-SwayP" >/dev/null 2>&1 || true
    fi
    gsettings set org.gnome.desktop.interface color-scheme "$GTK_TARGET_SCHEME" >/dev/null 2>&1 || true
fi

ln -sfn "$THEME_DIR" "$STATE_DIR/theme"
printf '%s\n' "$THEME" > "$PERSISTENT_THEME_FILE"

# Remove state files from pre-static-theme versions.
rm -f "$STATE_DIR/theme.name" "$STATE_DIR/palette-source"

# Each theme owns a default wallpaper named 01. Prefer it explicitly so
# adding another file cannot silently change the default. The first supported
# image remains a compatibility fallback for older pools.
THEME_WALLPAPER_DIR="$HOME/.config/swayp/wallpapers/$THEME"
DEFAULT_WALLPAPER=""
if [ -d "$THEME_WALLPAPER_DIR" ]; then
    for extension in jpg jpeg png webp svg; do
        if [ -f "$THEME_WALLPAPER_DIR/01.$extension" ]; then
            DEFAULT_WALLPAPER="$THEME_WALLPAPER_DIR/01.$extension"
            break
        fi
    done

    if [ -z "$DEFAULT_WALLPAPER" ]; then
        DEFAULT_WALLPAPER="$(
            find "$THEME_WALLPAPER_DIR" -maxdepth 1 -type f \
                \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.svg' \) \
                -print 2>/dev/null | sort | head -n 1
        )"
    fi
fi

# Start the fast wallpaper fade and palette transition together.
# Do not wait for awww: its CLI may remain attached to the transition request,
# which would make the palette update visibly lag behind the wallpaper.
#
# Fork awww first, then swap the staged palette immediately. Both transitions
# therefore begin from the same shell turn; the wallpaper fade is intentionally
# matches the Quickshell palette transition duration exactly.
# Apply the staged palette regardless of whether this theme has a
# curated wallpaper pool. Quickshell must not depend on a wallpaper existing.
# This is especially important for new themes while their wallpaper pools are
# still being curated.
if [ -f "$PALETTE_STAGED_OUTPUT" ]; then
    mv -f "$PALETTE_STAGED_OUTPUT" "$PALETTE_OUTPUT"

    if [ -n "$DEFAULT_WALLPAPER" ] && command -v awww >/dev/null 2>&1; then
        awww img \
            --transition-type fade \
            --transition-fps 240 \
            --transition-duration 0.50 \
            "$DEFAULT_WALLPAPER" >/dev/null 2>&1 &
        ln -sfn "$DEFAULT_WALLPAPER" "$STATE_DIR/background"
        printf '%s\n' "$DEFAULT_WALLPAPER" > "$HOME/.local/state/wallpaper/current"

        # Give awww a tiny head start so its compositor-side fade begins just
        # before Quickshell repaints the shell palette.
        sleep 0.019
    fi

    # Push the exact new palette directly into the running Quickshell instead
    # of waiting for FileView's filesystem watcher.
    if command -v qs >/dev/null 2>&1; then
        PALETTE_B64="$(base64 -w0 "$PALETTE_OUTPUT")"
        SHELL_B64="$(base64 -w0 "$THEME_DIR/theme.toml")"
        qs ipc call shell applyTheme "$PALETTE_B64" "$SHELL_B64" >/dev/null 2>&1 || true
    fi
fi

# Apply all runtime application colors at the beginning of the visual
# transition. Kitty and Sway must move with the wallpaper and Quickshell,
# not after the 500 ms reveal has already finished.

if command -v kitty >/dev/null 2>&1 && [ -f "$GENERATED_DIR/kitty-colors.conf" ]; then
    # Kitty creates one control socket per running instance. Discover the
    # sockets directly so every Kitty process gets the new palette.
    for KITTY_SOCKET_PATH in /tmp/swayp-kitty.sock-*; do
        [ -S "$KITTY_SOCKET_PATH" ] || continue
        kitty @ --to "unix:$KITTY_SOCKET_PATH" set-colors --all "$GENERATED_DIR/kitty-colors.conf" >/dev/null 2>&1 || true
    done
fi

if command -v swaymsg >/dev/null 2>&1; then
    SWAY_RUNTIME_COLORS="$GENERATED_DIR/sway-runtime-colors.sh"
    if [ -f "$SWAY_RUNTIME_COLORS" ]; then
        # shellcheck disable=SC1090
        . "$SWAY_RUNTIME_COLORS"
        swaymsg "client.focused $color_primary $color_primary_container $color_fg $color_primary $color_primary" >/dev/null 2>&1 || true
        swaymsg "client.focused_tab_title $color_primary $color_primary_container $color_fg $color_primary $color_primary" >/dev/null 2>&1 || true
        swaymsg "client.focused_inactive $color_outline $color_primary_container $color_fg $color_outline $color_outline" >/dev/null 2>&1 || true
        swaymsg "client.unfocused $color_outline $color_bg $color_fg $color_outline $color_bg" >/dev/null 2>&1 || true
        swaymsg "client.urgent $color_error $color_error $color_fg $color_error $color_error" >/dev/null 2>&1 || true
    fi
fi

printf 'SwayP theme applied: %s\n' "$THEME"
