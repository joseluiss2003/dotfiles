#!/bin/sh

set -eu

outputs="$(swaymsg -t get_outputs -r)"

brightness="$(
    swayp-brightness-display --get 2>/dev/null ||
    printf '%s\n' "unavailable"
)"

focused="$(
    printf '%s\n' "$outputs" |
    jq -r '
        .[] |
        .name
    ' |
    head -n1
)"

scale="$(
    printf '%s\n' "$outputs" |
    jq -r '
        .[] |
        select(.focused == true) |
        (.scale // 1)
    ' |
    head -n1
)"

[ -n "$focused" ] || focused=""
[ -n "$scale" ] || scale="1"

active="$(
    printf '%s\n' "$outputs" |
    jq -r '
        [.[] | select(.active == true) | .name] |
        if length > 0 then .[0] else "" end
    '
)"

internal="$(
    printf '%s\n' "$outputs" |
    jq -r '
        .[] |
        select(.active == true) |
        .name
    ' |
    grep -E '^(eDP|LVDS)' |
    head -n1 || true
)"

internalEnabled=""
if [ -n "$internal" ]; then
    internalEnabled="$internal"
fi

printf '%s\n' "$brightness"
printf '%s\n' "$internal"
printf '%s\n' "$active"
printf '%s\n' "$internalEnabled"
printf '%s\n' ""
printf '%s\n' "$focused"
printf '%s\n' "$scale"


printf '%s\n' "$outputs" |
    jq -c '
        [
            .[] |
            {
                name: .name,
                enabled: (.active // false),
                focused: (.focused // false),
                scale: (.scale // 1),
                x: (.rect.x // 0),
                y: (.rect.y // 0),
                transform: (.transform // "normal"),
                power: (.power // false),
                adaptiveSyncSupported: (.features.adaptive_sync // false),
                adaptiveSync: (.adaptive_sync_status // "unsupported"),
                currentMode: {
                    width: (.current_mode.width // 0),
                    height: (.current_mode.height // 0),
                    refresh: (.current_mode.refresh // 0)
                },
                modes: (
                    [.modes[]? |
                        select((.width // 0) > 0 and (.height // 0) > 0 and (.refresh // 0) > 0)
                    ] |
                    unique_by([.width, .height, .refresh]) |
                    sort_by(.width, .height, .refresh)
                ),
                make: (.make // ""),
                model: (.model // ""),
                serial: (.serial // "")
            }
        ]
    '
