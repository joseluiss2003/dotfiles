#!/bin/sh
set -eu

STATE_DIR="${HOME}/.local/state/swayp/current"
PALETTE="${STATE_DIR}/palette.json"
GENERATED_DIR="${HOME}/.config/swayp/generated"
OUTPUT="${GENERATED_DIR}/firefox-userChrome.css"

[ -f "$PALETTE" ] || exit 0
mkdir -p "$GENERATED_DIR"

python3 - "$PALETTE" "$OUTPUT" <<'PY'
import json, sys

palette_path, output_path = sys.argv[1:]
with open(palette_path, encoding="utf-8") as f:
    data = json.load(f)

c = data["semantic"]

css = f"""/*
 * Generated by SwayP.
 * Do not edit this file manually.
 *
 * Firefox consumes the same semantic palette as the rest of SwayP.
 */

:root {{
  --swayp-accent: {c["accent"]};
  --swayp-selection: {c["selection"]};
  --swayp-muted: {c["muted"]};
  --swayp-background: {c["background"]};
  --swayp-dark-background: {c["dark_background"]};
  --swayp-darker-background: {c["darker_background"]};
  --swayp-surface: {c["lighter_background"]};
  --swayp-foreground: {c["foreground"]};
  --swayp-dark-foreground: {c["dark_foreground"]};
  --swayp-light-foreground: {c["light_foreground"]};
  --swayp-bright-foreground: {c["bright_foreground"]};

  --toolbar-bgcolor: var(--swayp-background) !important;
  --toolbar-color: var(--swayp-foreground) !important;
  --lwt-accent-color: var(--swayp-background) !important;
  --lwt-text-color: var(--swayp-foreground) !important;
  --lwt-selected-tab-background-color: var(--swayp-surface) !important;
  --toolbar-field-background-color: var(--swayp-surface) !important;
  --toolbar-field-color: var(--swayp-foreground) !important;
  --toolbar-field-focus-background-color: var(--swayp-surface) !important;
  --toolbar-field-focus-color: var(--swayp-foreground) !important;
  --autocomplete-popup-background: var(--swayp-surface) !important;
  --autocomplete-popup-color: var(--swayp-foreground) !important;
  --panel-background: var(--swayp-surface) !important;
  --panel-color: var(--swayp-foreground) !important;
  --arrowpanel-background: var(--swayp-surface) !important;
  --arrowpanel-color: var(--swayp-foreground) !important;
  --sidebar-background-color: var(--swayp-background) !important;
  --sidebar-text-color: var(--swayp-foreground) !important;
}}

:root {{
  color-scheme: {"light" if data.get("colors", [])[0] == c["background"] and False else "dark"} !important;
}}

#navigator-toolbox,
#nav-bar,
#PersonalToolbar,
#TabsToolbar,
#toolbar-menubar,
.browser-toolbar {{
  background: var(--swayp-background) !important;
  color: var(--swayp-foreground) !important;
  border-color: var(--swayp-muted) !important;
  box-shadow: none !important;
}}

#TabsToolbar {{
  border-bottom: 1px solid var(--swayp-muted) !important;
}}

.tabbrowser-tab {{
  color: var(--swayp-muted) !important;
}}

.tabbrowser-tab[selected="true"] {{
  color: var(--swayp-foreground) !important;
}}

.tab-background[selected="true"] {{
  background: var(--swayp-surface) !important;
  box-shadow: inset 0 -2px 0 var(--swayp-accent) !important;
}}

.tab-background:hover:not([selected="true"]) {{
  background: var(--swayp-dark-background) !important;
}}

#urlbar,
#searchbar {{
  color: var(--swayp-foreground) !important;
}}

#urlbar-background,
#searchbar {{
  background: var(--swayp-surface) !important;
  border: 1px solid var(--swayp-muted) !important;
  box-shadow: none !important;
}}

#urlbar[focused="true"] > #urlbar-background {{
  border-color: var(--swayp-accent) !important;
  box-shadow: 0 0 0 1px var(--swayp-accent) !important;
}}

#urlbar-input {{
  color: var(--swayp-foreground) !important;
}}

.urlbarView-row {{
  color: var(--swayp-foreground) !important;
}}

.urlbarView-row[selected] {{
  background: var(--swayp-selection) !important;
  color: var(--swayp-foreground) !important;
}}

#PersonalToolbar {{
  background: var(--swayp-dark-background) !important;
}}

toolbarbutton:hover,
#nav-bar toolbarbutton:hover {{
  background: var(--swayp-surface) !important;
  color: var(--swayp-foreground) !important;
}}

toolbarbutton[checked="true"],
toolbarbutton[open="true"] {{
  background: var(--swayp-selection) !important;
  color: var(--swayp-foreground) !important;
}}

menupopup,
panel {{
  --panel-background: var(--swayp-surface) !important;
  --panel-color: var(--swayp-foreground) !important;
  --arrowpanel-background: var(--swayp-surface) !important;
  --arrowpanel-color: var(--swayp-foreground) !important;
}}

menupopup > menuitem:hover,
menupopup > menu:hover {{
  background: var(--swayp-selection) !important;
  color: var(--swayp-foreground) !important;
}}

#sidebar-box,
#sidebar {{
  background: var(--swayp-background) !important;
  color: var(--swayp-foreground) !important;
}}

findbar {{
  background: var(--swayp-surface) !important;
  color: var(--swayp-foreground) !important;
  border-top: 1px solid var(--swayp-muted) !important;
}}

#statuspanel-label {{
  background: var(--swayp-surface) !important;
  color: var(--swayp-foreground) !important;
  border: 1px solid var(--swayp-muted) !important;
}}

* {{
  scrollbar-color: var(--swayp-muted) var(--swayp-background) !important;
}}
"""

with open(output_path, "w", encoding="utf-8") as f:
    f.write(css)
PY

# Firefox profiles can live in the native Mozilla path or the Flatpak path.
PROFILE_ROOTS="
${HOME}/.mozilla/firefox
${HOME}/.var/app/org.mozilla.firefox/.mozilla/firefox
"

found=0
for root in $PROFILE_ROOTS; do
    [ -d "$root" ] || continue

    for prefs in "$root"/*/prefs.js; do
        [ -f "$prefs" ] || continue
        profile_dir="${prefs%/prefs.js}"
        chrome_dir="${profile_dir}/chrome"
        target="${chrome_dir}/userChrome.css"

        mkdir -p "$chrome_dir"

        if [ -e "$target" ] && [ ! -L "$target" ]; then
            backup="${target}.swayp-backup"
            if [ ! -e "$backup" ]; then
                cp -a "$target" "$backup"
            fi
        fi

        ln -sfn "$OUTPUT" "$target"

        user_js="${profile_dir}/user.js"
        touch "$user_js"
        if ! grep -Fqx 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' "$user_js"; then
            printf '%s\n' 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >> "$user_js"
        fi

        found=1
    done
done

if [ "$found" -eq 0 ]; then
    printf '%s\n' "SwayP Firefox: no Firefox profile found; generated CSS only." >&2
else
    printf '%s\n' "SwayP Firefox theme applied."
fi
