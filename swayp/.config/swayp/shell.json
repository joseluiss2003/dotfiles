{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "id": "swayp.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "swayp.clock",
    "layout": {
      "left": [
        {
          "id": "swayp.menu"
        },
        {
          "id": "swayp.workspaces"
        },
        {
          "id": "swayp.active-window"
        }
      ],
      "center": [
        {
          "id": "swayp.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "right": [
        {
          "id": "swayp.tray"
        },
        {
          "id": "swayp.media"
        },
        {
          "id": "swayp.bluetooth"
        },
        {
          "id": "swayp.network"
        },
        {
          "id": "swayp.audio"
        },
        {
          "id": "swayp.power"
        },
        {
          "id": "swayp.monitor"
        },
        {
          "id": "swayp.notification-center"
        }
      ]
    }
  },
  "plugins": []
}
