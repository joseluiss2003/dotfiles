{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/swayp/branding/swayp-fastfetch.txt",
    "color": {
      "1": "white",
      "2": "white",
      "3": "white",
      "4": "white",
      "5": "white",
      "6": "white"
    },
    "padding": { "top": 1, "right": 6, "left": 1 }
  },
  "display": {
    "disableLinewrap": true,
    "color": { "keys": "white", "output": "white", "separator": "bright_black" },
    "key": { "width": 14, "type": "string" }
  },
  "modules": [
    "break",
    { "type": "custom", "outputColor": "bright_black", "format": "┌──────────────────────Hardware────────────────────┐" },
    { "type": "host", "key": " PC" },
    { "type": "cpu", "key": " CPU" },
    { "type": "gpu", "key": " GPU" },
    { "type": "memory", "key": " Memoria" },
    { "type": "disk", "key": " Disco", "folders": ["/"] },
    { "type": "custom", "outputColor": "bright_black", "format": "└──────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "outputColor": "bright_black", "format": "┌──────────────────────Software────────────────────┐" },
    { "type": "os", "key": " OS" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "de", "key": " Entorno" },
    { "type": "shell", "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "packages", "key": " Paquetes" },
    { "type": "custom", "outputColor": "bright_black", "format": "└──────────────────────────────────────────────────┘" }
  ]
}
