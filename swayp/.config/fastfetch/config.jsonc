{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/swayp/branding/swayp-fastfetch.txt",
    "color": {
      "1": "cyan",
      "2": "blue",
      "3": "green",
      "4": "yellow",
      "5": "magenta",
      "6": "white"
    },
    "padding": { "top": 1, "right": 3, "left": 2 }
  },
  "display": {
    "disableLinewrap": true,
    "color": { "keys": "cyan", "output": "white", "separator": "bright_black" },
    "key": { "width": 14, "type": "string" }
  },
  "modules": [
    "break",
    { "type": "custom", "outputColor": "bright_black", "format": "┌──────────────────────Hardware────────────────────┐" },
    { "type": "host", "key": " PC", "keyColor": "cyan" },
    { "type": "cpu", "key": " CPU", "keyColor": "yellow" },
    { "type": "gpu", "key": " GPU", "keyColor": "blue" },
    { "type": "memory", "key": " Memoria", "keyColor": "green" },
    { "type": "disk", "key": " Disco", "keyColor": "cyan", "folders": ["/"] },
    { "type": "custom", "outputColor": "bright_black", "format": "└──────────────────────────────────────────────────┘" },
    "break",
    { "type": "custom", "outputColor": "bright_black", "format": "┌──────────────────────Software────────────────────┐" },
    { "type": "os", "key": " OS", "keyColor": "cyan" },
    { "type": "kernel", "key": " Kernel", "keyColor": "magenta" },
    { "type": "de", "key": " Entorno", "keyColor": "blue" },
    { "type": "shell", "key": " Shell", "keyColor": "green" },
    { "type": "terminal", "key": " Terminal", "keyColor": "cyan" },
    { "type": "packages", "key": " Paquetes", "keyColor": "yellow" },
    { "type": "custom", "outputColor": "bright_black", "format": "└──────────────────────────────────────────────────┘" },
    "break",
    { "type": "colors", "symbol": "block", "block": { "width": 3, "range": [0, 15] } }
  ]
}
