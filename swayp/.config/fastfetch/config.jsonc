{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/swayp/branding/swayp-fastfetch.txt",
    "color": {
      "1": "white",
      "2": "cyan"
    },
    "padding": {
      "right": 4
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "wm",
    "shell",
    "cpu",
    "gpu",
    "memory"
  ]
}
