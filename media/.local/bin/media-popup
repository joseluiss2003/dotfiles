#!/usr/bin/env python3

import os
import subprocess
import urllib.parse
import urllib.request

import gi

# Wayland environment
os.environ.setdefault(
    "XDG_RUNTIME_DIR",
    f"/run/user/{os.getuid()}"
)

if not os.environ.get("WAYLAND_DISPLAY"):
    runtime_dir = os.environ["XDG_RUNTIME_DIR"]

    try:
        displays = sorted(
            name
            for name in os.listdir(runtime_dir)
            if name.startswith("wayland-")
        )

        if displays:
            os.environ["WAYLAND_DISPLAY"] = displays[0]

    except OSError:
        pass

os.environ.setdefault("GDK_BACKEND", "wayland")

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")

from gi.repository import Gtk, Gdk, Gio, GLib
from gi.repository import Gtk4LayerShell as LayerShell


PLAYER = "playerctld"


def playerctl(*args):
    result = subprocess.run(
        ["playerctl", "--player", PLAYER, *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.strip()


def get_metadata():
    return {
        "title": playerctl("metadata", "title"),
        "artist": playerctl("metadata", "artist"),
        "album": playerctl("metadata", "album"),
        "status": playerctl("status"),
        "art": playerctl("metadata", "mpris:artUrl"),
    }


def format_time(seconds):
    seconds = max(0, int(seconds))
    return f"{seconds // 60}:{seconds % 60:02}"


class MediaPopup(Gtk.Application):

    def __init__(self):
        super().__init__(
            application_id="com.joseluis.media-popup"
        )

        self.window = None
        self.cover = None
        self.title_label = None
        self.artist_label = None
        self.album_label = None
        self.position_scale = None
        self.position_label = None
        self.duration_label = None
        self.play_button = None

        self.updating = False
        self.last_art = None

    def do_activate(self):

        if self.window is not None:
            self.window.present()
            self.refresh()
            return

        self.window = Gtk.Window(
            application=self
        )

        self.window.set_default_size(360, 450)
        self.window.set_resizable(False)
        self.window.set_decorated(False)
        self.window.add_css_class("media-popup-window")

        # Layer Shell
        LayerShell.init_for_window(self.window)

        LayerShell.set_layer(
            self.window,
            LayerShell.Layer.TOP
        )

        LayerShell.set_anchor(
            self.window,
            LayerShell.Edge.TOP,
            True
        )

        LayerShell.set_anchor(
            self.window,
            LayerShell.Edge.LEFT,
            True
        )

        LayerShell.set_margin(
            self.window,
            LayerShell.Edge.TOP,
            2
        )

        LayerShell.set_margin(
            self.window,
            LayerShell.Edge.LEFT,
            2
        )

        LayerShell.set_exclusive_zone(
            self.window,
            -1
        )

        # Root
        root = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=10
        )

        root.set_name("popup")

        self.window.set_child(root)

        # Header
        header = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8
        )

        header_label = Gtk.Label(
            label="Reproduciendo"
        )

        header_label.set_xalign(0)
        header_label.set_hexpand(True)
        header_label.add_css_class("header")

        close_button = Gtk.Button(
            label="×"
        )

        close_button.set_has_frame(False)
        close_button.add_css_class("close")

        close_button.connect(
            "clicked",
            lambda *_: self.window.close()
        )

        header.append(header_label)
        header.append(close_button)

        root.append(header)

        # Cover
        self.cover = Gtk.Picture()

        self.cover.set_size_request(
            260,
            260
        )

        self.cover.set_content_fit(
            Gtk.ContentFit.COVER
        )

        self.cover.add_css_class("cover")

        root.append(self.cover)

        # Title
        self.title_label = Gtk.Label()

        self.title_label.set_xalign(0.5)
        self.title_label.set_wrap(True)
        self.title_label.add_css_class("title")

        root.append(self.title_label)

        # Artist
        self.artist_label = Gtk.Label()

        self.artist_label.set_xalign(0.5)
        self.artist_label.add_css_class("artist")

        root.append(self.artist_label)

        # Album
        self.album_label = Gtk.Label()

        self.album_label.set_xalign(0.5)
        self.album_label.add_css_class("album")

        root.append(self.album_label)

        # Progress
        progress_box = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=2
        )

        self.position_scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL,
            0,
            100,
            1
        )

        self.position_scale.set_draw_value(False)
        self.position_scale.set_hexpand(True)

        self.position_scale.connect(
            "value-changed",
            self.on_seek
        )

        time_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL
        )

        self.position_label = Gtk.Label()

        self.position_label.set_xalign(0)

        self.duration_label = Gtk.Label()

        self.duration_label.set_xalign(1)
        self.duration_label.set_hexpand(True)

        time_box.append(self.position_label)
        time_box.append(self.duration_label)

        progress_box.append(self.position_scale)
        progress_box.append(time_box)

        root.append(progress_box)

        # Controls
        controls = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=16
        )

        controls.set_halign(Gtk.Align.CENTER)

        previous = Gtk.Button(
            label="󰒮"
        )

        self.play_button = Gtk.Button(
            label="󰐊"
        )

        next_button = Gtk.Button(
            label="󰒭"
        )

        previous.set_has_frame(False)
        self.play_button.set_has_frame(False)
        next_button.set_has_frame(False)

        previous.add_css_class("control")
        self.play_button.add_css_class("play")
        next_button.add_css_class("control")

        previous.connect(
            "clicked",
            lambda *_: self.command("previous")
        )

        self.play_button.connect(
            "clicked",
            lambda *_: self.command("play-pause")
        )

        next_button.connect(
            "clicked",
            lambda *_: self.command("next")
        )

        controls.append(previous)
        controls.append(self.play_button)
        controls.append(next_button)

        root.append(controls)

        # Matugen CSS
        css_path = os.path.expanduser(
            "~/.config/matugen/generated/media-popup.css"
        )

        if os.path.exists(css_path):
            provider = Gtk.CssProvider()
            provider.load_from_path(css_path)

            Gtk.StyleContext.add_provider_for_display(
                self.window.get_display(),
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        self.refresh()

        self.window.present()

        GLib.timeout_add(
            500,
            self.refresh
        )

    def refresh(self):

        if self.window is None:
            return True

        metadata = get_metadata()

        title = metadata["title"] or "Sin reproducción"
        artist = metadata["artist"] or ""
        album = metadata["album"] or ""

        self.title_label.set_text(title)
        self.artist_label.set_text(artist)
        self.album_label.set_text(album)

        if metadata["status"] == "Playing":
            self.play_button.set_label("󰏤")
        else:
            self.play_button.set_label("󰐊")

        self.load_cover(
            metadata["art"]
        )

        length_raw = playerctl(
            "metadata",
            "mpris:length"
        )

        try:
            length = int(length_raw) / 1_000_000
        except (ValueError, TypeError):
            length = 0

        position_raw = playerctl(
            "position"
        )

        try:
            position = float(position_raw)
        except (ValueError, TypeError):
            position = 0

        self.updating = True

        self.position_scale.set_range(
            0,
            max(length, 1)
        )

        self.position_scale.set_value(
            min(position, length)
        )

        self.updating = False

        self.position_label.set_text(
            format_time(position)
        )

        self.duration_label.set_text(
            format_time(length)
        )

        return True

    def load_cover(self, art_url):

        if not art_url:
            self.cover.set_paintable(None)
            return

        if art_url == self.last_art:
            return

        self.last_art = art_url

        try:

            if art_url.startswith("file://"):

                path = urllib.parse.unquote(
                    urllib.parse.urlparse(
                        art_url
                    ).path
                )

                texture = Gdk.Texture.new_from_file(
                    Gio.File.new_for_path(path)
                )

            elif art_url.startswith(
                ("http://", "https://")
            ):

                data = urllib.request.urlopen(
                    art_url,
                    timeout=3
                ).read()

                texture = Gdk.Texture.new_from_bytes(
                    GLib.Bytes.new(data)
                )

            else:
                texture = None

            if texture:
                self.cover.set_paintable(
                    texture
                )

        except Exception:
            self.cover.set_paintable(None)

    def command(self, command):

        subprocess.Popen(
            [
                "playerctl",
                "--player",
                PLAYER,
                command
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

    def on_seek(self, scale):

        if self.updating:
            return

        value = scale.get_value()

        subprocess.Popen(
            [
                "playerctl",
                "--player",
                PLAYER,
                "position",
                str(value)
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )


app = MediaPopup()
app.run(None)
