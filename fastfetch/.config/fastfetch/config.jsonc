{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
      "top": 1,
      "right": 4
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "white",
      "output": "white",
      "separator": "white"
    },
    "key": {
      "width": 10
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },

    "break",

    {
      "type": "custom",
      "format": "SYSTEM"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },

    "break",

    {
      "type": "custom",
      "format": "HARDWARE"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": ["/"]
    },

    "break",

    {
      "type": "custom",
      "format": "SESSION"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name} ({version})"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    }
  ]
}
