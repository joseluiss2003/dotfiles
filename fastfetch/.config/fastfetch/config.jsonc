{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "green"
    },
    "padding": {
      "top": 1,
      "right": 5,
      "left": 1
    }
  },

  "display": {
    "disableLinewrap": true,
    "key": {
      "width": 5,
      "type": "both"
    }
  },

  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Hardware ──────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "format": "{name}",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ └󰋊",
      "keyColor": "green",
      "folders": ["/"]
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Software ──────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "└ └󰏖",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
    },

    "break",
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    }
  ]
}
