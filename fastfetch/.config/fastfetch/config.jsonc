{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "color": {
      "1": "#ffb2bf",
      "2": "#d9a8b0",
      "3": "#e6a8b8",
      "4": "#ffb4ab",
      "5": "#cbbfc1",
      "6": "#ffb2bf"
    },
    "padding": {
      "top": 2,
      "right": 5,
      "left": 1
    }
  },

  "display": {
    "disableLinewrap": true,
    "key": {
      "width": 11,
      "type": "both"
    }
  },

  "modules": [
    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "gpu",
      "key": " GPU",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "memory",
      "key": " Memoria",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "disk",
      "key": " Disco",
      "keyColor": "#ffb2bf",
      "folders": ["/"]
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────┘"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "de",
      "key": " Entorno",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "packages",
      "key": " Paquetes",
      "keyColor": "#ffb2bf"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────┘"
    },

    "break",
    "colors"
  ]
}