{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    }
  },

  "modules": [
    "title",

    {
      "type": "custom",
      "key": "SYSTEM",
      "format": ""
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },

    {
      "type": "custom",
      "key": "ENVIRONMENT",
      "format": ""
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name} ({version})"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },

    {
      "type": "custom",
      "key": "HARDWARE",
      "format": ""
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": ["/"]
    }
  ]
}
