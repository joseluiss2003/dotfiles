include ~/.config/matugen/generated/sway-colors.conf


### =========================
### Sway - José Luis
### =========================

### Mod
set $mod Mod4

### Terminal
set $term kitty

### Launcher
set $menu fuzzel

###Layout tabbed
workspace_layout tabbed
default_orientation horizontal

### =========================
### Apariencia
### =========================

font pango:JetBrains Mono Nerd Font 10

### =========================
### Input
### =========================

input type:keyboard {
    xkb_layout es
}

### =========================
### Atajos básicos
### =========================

# Terminal
bindsym $mod+Return exec $term

# Launcher
bindsym $mod+d exec $menu
bindsym $mod+w exec ~/.local/bin/wallpaper-picker

# Cerrar ventana
bindsym $mod+q kill

# Recargar configuración
bindsym $mod+Shift+c reload

# Salir de Sway
bindsym $mod+Shift+e exit

### Movimiento con flechas
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

### =========================
### Mover ventanas
### =========================

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Floating
bindsym $mod+Shift+Space floating toggle

### Focus entre tiling/floating
bindsym $mod+Space focus mode_toggle

### =========================
### Workspaces
### =========================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

### Mover ventana a workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

### =========================
### Resize ventanas
### =========================

bindsym $mod+Ctrl+Left  resize shrink width 10 px
bindsym $mod+Ctrl+Right resize grow width 10 px
bindsym $mod+Ctrl+Up    resize shrink height 10 px
bindsym $mod+Ctrl+Down  resize grow height 10 px

### =========================
### Screenshot
### =========================

bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

### =========================
### Window rules
### =========================

# Firefox/Chromium y demás permanecen en tiling por defecto.
# Aquí añadiremos reglas específicas cuando las necesitemos.
floating_modifier $mod normal


### =========================
### Startup
### =========================

exec awww-daemon
exec qs
exec mako
exec playerctld daemon


exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark

### =========================
### Defaults
### =========================

default_border pixel 2
default_floating_border normal 2
focus_follows_mouse yes

# Espacio entre ventanas
gaps inner 2

# Margen entre ventanas y los bordes de la pantalla
gaps outer 2


### =========================
### Include
### =========================

include /etc/sway/config.d/*

### =========================
### sonido
### =========================
for_window [app_id="pavucontrol"] floating enable, sticky enable, border pixel 1

# Bloqueo manual
bindsym $mod+l exec qs ipc call lock lock


# Idle / lock
exec swayidle -w \
    timeout 300 'qs ipc call lock lock' \
    timeout 600 'swaymsg "output * power off"' \
    before-sleep 'qs ipc call lock lock' \
    resume 'swaymsg "output * power on"'
