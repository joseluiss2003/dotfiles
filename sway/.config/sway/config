include ~/.config/swayp/generated/sway-colors.conf

### =========================
### SwayP - Sway configuration
### =========================

set $mod Mod4
set $term kitty
set $menu fuzzel

font pango:JetBrains Mono Nerd Font 10

input type:keyboard {
    xkb_layout es
}

### =========================
### Window management
### =========================

# Focus
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Floating
bindsym $mod+Shift+Space floating toggle

# Resize
bindsym $mod+Ctrl+Left  resize shrink width 10 px
bindsym $mod+Ctrl+Right resize grow width 10 px
bindsym $mod+Ctrl+Up    resize shrink height 10 px
bindsym $mod+Ctrl+Down  resize grow height 10 px

floating_modifier $mod normal

### =========================
### Workspaces
### =========================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move window to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

workspace_layout tabbed
default_orientation horizontal

### =========================
### Basic actions
### =========================

bindsym $mod+Return exec $term
bindsym $mod+d exec env PATH="$HOME/.local/bin:$PATH" swayp-launcher
bindsym $mod+q kill
bindsym $mod+f exec nautilus

bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit

### =========================
### Screenshots
### =========================

bindsym $mod+Shift+s exec env PATH="$HOME/.local/bin:$PATH" swayp-screenshot-edit

### =========================
### SwayP
### =========================

# Wallpaper and appearance selectors stay last so system snippets cannot override them.
bindsym --no-repeat $mod+w exec env PATH="$HOME/.local/bin:$PATH" wallpaper-picker
bindsym --no-repeat $mod+t exec env PATH="$HOME/.local/bin:$PATH" swayp-theme-picker

# Manual lock
bindsym $mod+l exec qs ipc call lock lock

### =========================
### Window rules
### =========================

for_window [app_id="pavucontrol"] floating enable, sticky enable, border pixel 1

### =========================
### Startup
### =========================

exec awww-daemon
exec env PATH="$HOME/.local/bin:$PATH" wallpaper-startup
exec env PATH="$HOME/.local/bin:$PATH" qs
exec playerctld daemon

exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec gsettings set org.gnome.desktop.interface color-scheme prefer-dark
exec gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark

exec swayidle -w \
    timeout 300 'qs ipc call lock lock' \
    timeout 600 'swaymsg "output * power off"' \
    before-sleep 'qs ipc call lock lock' \
    resume 'swaymsg "output * power on"'

### =========================
### Defaults
### =========================

default_border pixel 2
default_floating_border normal 2
focus_follows_mouse yes

gaps inner 2
gaps outer 2

### =========================
### System configuration
### =========================

include /etc/sway/config.d/*
